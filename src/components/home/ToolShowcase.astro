---
import { ChevronRight, FileSearch, Hammer, Layers } from "lucide-react";

import { highlightCodeToHtml } from "../../lib/highlight";
import { ConverterIcon } from "../ui/ConverterIcon";
import Panel from "../ui/Panel.astro";

import type {
  CategoryBar,
  CollectionPreview,
  SigmaPreview,
} from "../../lib/homepage";

interface Props {
  totalTargets: number;
  categoryBars: CategoryBar[];
  collection: CollectionPreview;
  builderLines: string[];
  sigma: SigmaPreview;
}

const { totalTargets, categoryBars, collection, builderLines, sigma } =
  Astro.props;

const BAR_LABEL_RESERVE_PERCENT = 82;
const numberFormat = new Intl.NumberFormat("en-US");

const collectionTargetCount = collection.featured.length + collection.moreCount;
const collectionTreeLines = [
  ...collection.featured.map((name) => ({ name, isLast: false })),
  ...(collection.moreCount > 0
    ? [
        {
          name: `${collection.moreCount} more ${collection.moreCount === 1 ? "target" : "targets"}`,
          isLast: true,
        },
      ]
    : []),
];

const builderScriptHtml = await highlightCodeToHtml(
  builderLines.join("\n"),
  "powershell"
);
const sigmaExcerptHtml = await highlightCodeToHtml(sigma.excerpt, "yaml");

const iconBoxClass =
  "mb-4 flex h-9 w-9 items-center justify-center rounded-md border border-border bg-secondary text-muted-foreground";
const codeStripClass =
  "bg-console p-4 font-mono text-[12.5px] leading-6 text-console-foreground [&_pre]:m-0 [&_pre]:bg-transparent! [&_code]:font-mono";
const linkClass =
  "inline-flex items-center gap-1 text-xl font-medium tracking-tight after:absolute after:inset-0 hover:underline hover:underline-offset-4";
---

<section
  aria-labelledby="tools-heading"
  class="py-10 sm:py-14"
>
  <h2
    id="tools-heading"
    class="max-w-xl text-2xl font-semibold tracking-tight text-balance sm:text-3xl"
  >
    Find it, collect it, then hunt for it
  </h2>

  <ul class="mt-10 flex flex-col gap-16">
    <li class="relative grid grid-cols-1 gap-6 md:grid-cols-12 md:gap-10">
      <div class="md:col-span-5">
        <span class={iconBoxClass}><FileSearch aria-hidden="true" className="h-4 w-4" /></span>
        <h3>
          <a class={linkClass} href="/artifacts">
            Artifacts
            <ChevronRight aria-hidden="true" className="h-4 w-4 text-muted-foreground" />
          </a>
        </h3>
        <p class="mt-2 max-w-sm text-muted-foreground">
          Browse {totalTargets} artifacts with the folders, file masks and
          documentation behind each one.
        </p>
      </div>
      <div class="md:col-span-7">
        <Panel data-reveal headingId="categories-preview-heading" headingTag="h4">
          <Fragment slot="title">Targets per category</Fragment>
          <Fragment slot="subtitle">
            {`${numberFormat.format(totalTargets)} targets in ${categoryBars.length} categories`}
          </Fragment>
          <ul class="space-y-2.5 p-4 font-sans text-[13px]">
            {categoryBars.map((bar, index) => (
              <li style={`--reveal-index: ${index}; --reveal-step: 80ms`}>
                <a
                  class="group relative z-10 grid grid-cols-[5.5rem_minmax(0,1fr)] items-center gap-3"
                  href={`/category/${bar.slug}`}
                >
                  <span class="reveal-item text-muted-foreground transition-colors group-hover:text-foreground">
                    {bar.name}
                  </span>
                  <span class="flex items-center gap-2">
                    <span
                      class="reveal-bar h-1.5 rounded-r-[4px] bg-console-accent"
                      style={`width: ${(bar.widthPercent * BAR_LABEL_RESERVE_PERCENT) / 100}%`}
                    />
                    <span class="reveal-count tabular-nums text-foreground">
                      {bar.count}
                    </span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </Panel>
      </div>
    </li>

    <li class="relative grid grid-cols-1 gap-6 md:grid-cols-12 md:gap-10">
      <div class="md:col-span-5">
        <span class={iconBoxClass}><Layers aria-hidden="true" className="h-4 w-4" /></span>
        <h3>
          <a class={linkClass} href="/collections">
            Collections
            <ChevronRight aria-hidden="true" className="h-4 w-4 text-muted-foreground" />
          </a>
        </h3>
        <p class="mt-2 max-w-sm text-muted-foreground">
          Ready-made sets for triage, like {collection.name}. Each one expands
          to every artifact it collects.
        </p>
      </div>
      <div class="md:col-span-7">
        <Panel aria-hidden="true" data-reveal headingTag="h4">
          <Fragment slot="title">
            <span class="text-console-accent">{collection.name}</span>
          </Fragment>
          <Fragment slot="subtitle">
            {`${collectionTargetCount} targets, resolving to ${collection.artifactCount} artifacts and ${numberFormat.format(collection.pathCount)} paths`}
          </Fragment>
          <pre class="whitespace-pre p-4 font-mono text-[12.5px] leading-6 text-foreground">{collectionTreeLines.map((line, index) => (<span class="reveal-item block" style={`--reveal-index: ${index}; --reveal-step: 90ms`}><span class="text-muted-foreground">{line.isLast ? "└─ " : "├─ "}</span><span class={line.isLast ? "text-muted-foreground" : ""}>{line.name}</span></span>))}</pre>
        </Panel>
      </div>
    </li>

    <li class="relative grid grid-cols-1 gap-6 md:grid-cols-12 md:gap-10">
      <div class="md:col-span-5">
        <span class={iconBoxClass}><Hammer aria-hidden="true" className="h-4 w-4" /></span>
        <h3>
          <a class={linkClass} href="/builder">
            KAPE Command Builder
            <ChevronRight aria-hidden="true" className="h-4 w-4 text-muted-foreground" />
          </a>
        </h3>
        <p class="mt-2 max-w-sm text-muted-foreground">
          Start from an incident scenario, or pick targets and modules. Get a
          KAPE command, a _kape.cli batch file, or a fallback script.
        </p>
      </div>
      <div class="md:col-span-7">
        <Panel aria-hidden="true" data-reveal headingTag="h4">
          <Fragment slot="title">Ransomware scenario</Fragment>
          <Fragment slot="subtitle">KAPE command</Fragment>
          <div class:list={[codeStripClass, "[--reveal-step:60ms] [&_pre]:whitespace-pre-wrap [&_pre]:[overflow-wrap:anywhere] [&_code]:whitespace-pre-wrap"]} data-reveal-lines set:html={builderScriptHtml} />
        </Panel>
      </div>
    </li>

    <li class="relative grid grid-cols-1 gap-6 md:grid-cols-12 md:gap-10">
      <div class="md:col-span-5">
        <span class={iconBoxClass}><ConverterIcon className="h-3.5 w-3.5" /></span>
        <h3>
          <a class={linkClass} href="/converter">
            Sigma Converter
            <ChevronRight aria-hidden="true" className="h-4 w-4 text-muted-foreground" />
          </a>
        </h3>
        <p class="mt-2 max-w-sm text-muted-foreground">
          Convert {numberFormat.format(sigma.ruleCount)} SigmaHQ rules, or your
          own, to {sigma.backendCount} query languages. It all runs in your
          browser.
        </p>
      </div>
      <div class="md:col-span-7">
        <Panel aria-hidden="true" data-reveal headingTag="h4">
          <Fragment slot="title">Sigma rule</Fragment>
          <Fragment slot="subtitle">YAML</Fragment>
          <div class:list={[codeStripClass, "[--reveal-step:55ms] [&_pre]:overflow-x-auto"]} data-reveal-lines set:html={sigmaExcerptHtml} />
          <Fragment slot="footer">
            <span>{sigma.credit}. Converts to {sigma.featuredBackends.join(", ")} and {sigma.moreBackendCount} more.</span>
          </Fragment>
        </Panel>
      </div>
    </li>
  </ul>
</section>

<script>
  const REVEAL_VISIBLE_RATIO = 0.25;

  const indexCodeLines = (panel: HTMLElement) => {
    for (const block of panel.querySelectorAll<HTMLElement>(
      "[data-reveal-lines]"
    )) {
      const lines = block.querySelectorAll<HTMLElement>(".line");
      for (const [index, line] of [...lines].entries()) {
        line.classList.add("reveal-item");
        line.style.setProperty("--reveal-index", String(index));
      }
    }
  };

  const armRevealPanels = () => {
    const panels = document.querySelectorAll<HTMLElement>(
      "[data-reveal]:not([data-armed])"
    );
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;
    if (
      panels.length === 0 ||
      prefersReducedMotion ||
      !("IntersectionObserver" in window)
    ) {
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting && entry.target instanceof HTMLElement) {
            entry.target.dataset.revealed = "";
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: REVEAL_VISIBLE_RATIO }
    );

    for (const panel of panels) {
      indexCodeLines(panel);
      panel.dataset.armed = "";
      observer.observe(panel);
    }
  };

  document.addEventListener("astro:page-load", armRevealPanels);
</script>
