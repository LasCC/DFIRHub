---
import { ChevronRight, FileSearch, Hammer, Layers } from "lucide-react";

import { highlightCodeToHtml } from "../../lib/highlight";
import { ConverterIcon } from "../ui/ConverterIcon";

import type {
  CategoryBar,
  CollectionPreview,
  SigmaPreview,
} from "../../lib/homepage";

interface Props {
  totalTargets: number;
  categoryBars: CategoryBar[];
  collection: CollectionPreview;
  builderLines: string[];
  sigma: SigmaPreview;
}

const { totalTargets, categoryBars, collection, builderLines, sigma } =
  Astro.props;

const BAR_LABEL_RESERVE_PERCENT = 82;
const numberFormat = new Intl.NumberFormat("en-US");

const collectionTreeLines = [
  ...collection.featured.map((name) => ({ name, isLast: false })),
  ...(collection.moreCount > 0
    ? [{ name: `${collection.moreCount} more collections`, isLast: true }]
    : []),
];

const builderScriptHtml = await highlightCodeToHtml(
  builderLines.join("\n"),
  "powershell"
);
const sigmaExcerptHtml = await highlightCodeToHtml(sigma.excerpt, "yaml");

const iconBoxClass =
  "mb-4 flex h-9 w-9 items-center justify-center rounded-md border border-border bg-secondary text-muted-foreground";
const panelClass =
  "rounded-lg border border-console-line bg-console p-4 font-mono text-[12.5px] leading-6 text-console-foreground [&_pre]:m-0 [&_pre]:bg-transparent! [&_code]:font-mono";
const linkClass =
  "inline-flex items-center gap-1 text-xl font-medium tracking-tight after:absolute after:inset-0 hover:underline hover:underline-offset-4";
---

<section
  aria-labelledby="tools-heading"
  class="py-10 sm:py-14"
>
  <h2
    id="tools-heading"
    class="max-w-xl text-2xl font-semibold tracking-tight text-balance sm:text-3xl"
  >
    Find it, collect it, then hunt for it
  </h2>

  <ul class="mt-10 flex flex-col gap-16">
    <li class="relative grid grid-cols-1 gap-6 md:grid-cols-12 md:gap-10">
      <div class="md:col-span-5">
        <span class={iconBoxClass}><FileSearch aria-hidden="true" className="h-4 w-4" /></span>
        <h3>
          <a class={linkClass} href="/artifacts">
            Artifacts
            <ChevronRight aria-hidden="true" className="h-4 w-4 text-muted-foreground" />
          </a>
        </h3>
        <p class="mt-2 max-w-sm text-muted-foreground">
          Browse {totalTargets} artifacts with the folders, file masks and
          documentation behind each one.
        </p>
      </div>
      <div class="md:col-span-7">
        <div class={panelClass}>
          <p class="mb-3 font-sans text-xs text-console-muted">
            Targets per category
          </p>
          <ul class="space-y-2.5 font-sans text-[13px]">
            {categoryBars.map((bar) => (
              <li>
                <a
                  class="group relative z-10 grid grid-cols-[5.5rem_minmax(0,1fr)] items-center gap-3"
                  href={`/category/${bar.slug}`}
                >
                  <span class="text-console-muted transition-colors group-hover:text-console-foreground">
                    {bar.name}
                  </span>
                  <span class="flex items-center gap-2">
                    <span
                      class="h-1.5 rounded-r-[4px] bg-console-accent"
                      style={`width: ${(bar.widthPercent * BAR_LABEL_RESERVE_PERCENT) / 100}%`}
                    />
                    <span class="tabular-nums text-console-foreground">
                      {bar.count}
                    </span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </li>

    <li class="relative grid grid-cols-1 gap-6 md:grid-cols-12 md:gap-10">
      <div class="md:col-span-5">
        <span class={iconBoxClass}><Layers aria-hidden="true" className="h-4 w-4" /></span>
        <h3>
          <a class={linkClass} href="/collections">
            Collections
            <ChevronRight aria-hidden="true" className="h-4 w-4 text-muted-foreground" />
          </a>
        </h3>
        <p class="mt-2 max-w-sm text-muted-foreground">
          Ready-made sets for triage, like {collection.name}. Each one expands
          to every artifact it collects.
        </p>
      </div>
      <div class="md:col-span-7">
        <div aria-hidden="true" class={panelClass}>
          <pre class="whitespace-pre"><span class="block text-console-accent">{collection.name}</span>{collectionTreeLines.map((line) => (<span class="block"><span class="text-console-muted">{line.isLast ? "└─ " : "├─ "}</span><span class={line.isLast ? "text-console-muted" : ""}>{line.name}</span></span>))}</pre>
          <p class="mt-3 font-sans text-xs text-console-muted">
            Resolves to {collection.artifactCount} artifacts and {numberFormat.format(collection.pathCount)} paths.
          </p>
        </div>
      </div>
    </li>

    <li class="relative grid grid-cols-1 gap-6 md:grid-cols-12 md:gap-10">
      <div class="md:col-span-5">
        <span class={iconBoxClass}><Hammer aria-hidden="true" className="h-4 w-4" /></span>
        <h3>
          <a class={linkClass} href="/builder">
            Script Builder
            <ChevronRight aria-hidden="true" className="h-4 w-4 text-muted-foreground" />
          </a>
        </h3>
        <p class="mt-2 max-w-sm text-muted-foreground">
          Tick the artifacts you need. Get a PowerShell, batch or WSL script,
          or a single KAPE command.
        </p>
      </div>
      <div class="md:col-span-7">
        <div aria-hidden="true" class={panelClass}>
          <div class="[&_pre]:whitespace-pre-wrap [&_pre]:[overflow-wrap:anywhere] [&_code]:whitespace-pre-wrap" set:html={builderScriptHtml} />
        </div>
      </div>
    </li>

    <li class="relative grid grid-cols-1 gap-6 md:grid-cols-12 md:gap-10">
      <div class="md:col-span-5">
        <span class={iconBoxClass}><ConverterIcon className="h-3.5 w-3.5" /></span>
        <h3>
          <a class={linkClass} href="/converter">
            Sigma Converter
            <ChevronRight aria-hidden="true" className="h-4 w-4 text-muted-foreground" />
          </a>
        </h3>
        <p class="mt-2 max-w-sm text-muted-foreground">
          Convert {numberFormat.format(sigma.ruleCount)} SigmaHQ rules, or your
          own, to {sigma.backendCount} query languages. It all runs in your
          browser.
        </p>
      </div>
      <div class="md:col-span-7">
        <div aria-hidden="true" class={panelClass}>
          <div class="[&_pre]:overflow-x-auto" set:html={sigmaExcerptHtml} />
          <p class="mt-3 border-t border-console-line pt-3 font-sans text-xs text-console-muted">
            {sigma.credit}. Converts to {sigma.featuredBackends.join(", ")} and {sigma.moreBackendCount} more.
          </p>
        </div>
      </div>
    </li>
  </ul>
</section>
