---
const currentYear = new Date().getFullYear();
---

<footer aria-label="Site footer" class="mt-auto border-t">
  <div class="mx-auto max-w-6xl px-4 py-10">
    <div class="mb-8 grid grid-cols-1 gap-8 sm:grid-cols-3">
      <!-- Brand Column -->
      <div>
        <a class="mb-3 inline-block font-semibold text-base" href="/">
          DFIRHub
        </a>
        <p class="max-w-md text-muted-foreground text-sm">
          The comprehensive resource for Windows forensic artifacts. Search,
          explore, and generate collection scripts for DFIR investigations.
        </p>
      </div>

      <!-- Navigation Column -->
      <div>
        <h3 class="mb-3 font-medium text-foreground text-sm">Navigate</h3>
        <nav aria-label="Footer navigation" class="space-y-2">
          <a
            class="block text-muted-foreground text-sm transition-colors hover:text-foreground"
            href="/artifacts"
          >
            All Artifacts
          </a>
          <a
            class="block text-muted-foreground text-sm transition-colors hover:text-foreground"
            href="/collections"
          >
            Collections
          </a>
          <a
            class="block text-muted-foreground text-sm transition-colors hover:text-foreground"
            href="/builder"
          >
            Script Builder
          </a>
          <a
            class="block text-muted-foreground text-sm transition-colors hover:text-foreground"
            href="/converter"
          >
            Sigma Converter
          </a>
        </nav>
      </div>

      <!-- Resources Column -->
      <div>
        <h3 class="mb-3 font-medium text-foreground text-sm">Resources</h3>
        <nav aria-label="External resources" class="space-y-2">
          <a
            class="block text-muted-foreground text-sm transition-colors hover:text-foreground"
            href="https://github.com/LasCC/DFIRHub"
            rel="noopener noreferrer"
            target="_blank"
          >
            GitHub<span class="sr-only">(opens in new tab)</span>
          </a>
          <a
            class="block text-muted-foreground text-sm transition-colors hover:text-foreground"
            href="https://github.com/EricZimmerman/KapeFiles"
            rel="noopener noreferrer"
            target="_blank"
          >
            KapeFiles<span class="sr-only">(opens in new tab)</span>
          </a>
          <a
            class="block text-muted-foreground text-sm transition-colors hover:text-foreground"
            href="https://ericzimmerman.github.io/KapeDocs/"
            rel="noopener noreferrer"
            target="_blank"
          >
            KAPE Documentation<span class="sr-only">(opens in new tab)</span>
          </a>
          <a
            class="block text-muted-foreground text-sm transition-colors hover:text-foreground"
            href="https://www.sans.org/tools/kape/"
            rel="noopener noreferrer"
            target="_blank"
          >
            SANS KAPE<span class="sr-only">(opens in new tab)</span>
          </a>
        </nav>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t pt-6">
      <p class="text-muted-foreground text-xs">
        &copy; {currentYear} DFIRHub. Data sourced from{" "}
        <a
          class="text-primary transition-colors hover:underline"
          href="https://github.com/EricZimmerman/KapeFiles"
          rel="noopener noreferrer"
          target="_blank"
        >
          KapeFiles
        </a>
      </p>
    </div>
  </div>
</footer>
