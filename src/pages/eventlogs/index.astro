---
import { CategoryFilters } from "../../components/artifacts/CategoryFilters";
import Footer from "../../components/layout/Footer.astro";
import { Header } from "../../components/layout/Header";
import Panel from "../../components/ui/Panel.astro";
import Layout from "../../layouts/Layout.astro";
import {
  EVENTLOG_CATEGORY_ORDER,
  EVENTLOG_CONTRIBUTORS_URL,
  EVENTLOG_LICENSE_URL,
  EVENTLOG_MAPS_URL,
  getEventLogCategoryId,
  getEventLogEventsByCategory,
  loadEventLogEvents,
} from "../../lib/eventlogs";
import {
  buildBreadcrumbJsonLd,
  serializeJsonForScript,
  SITE_URL,
  truncateAtWord,
} from "../../lib/seo";

const events = loadEventLogEvents();
const eventsByCategory = getEventLogEventsByCategory();
const groupedEvents = EVENTLOG_CATEGORY_ORDER.flatMap((category) => {
  const items = eventsByCategory.get(category);
  return items ? [[category, items] as const] : [];
});
const channelCount = new Set(events.map((event) => event.channel)).size;

const seoDescription = truncateAtWord(
  `Browse ${events.length} Windows event IDs from ${channelCount} event logs, from Security 4624 and 4688 to Sysmon, PowerShell and RDP, with the fields EvtxECmd extracts.`,
  158
);

const breadcrumbJsonLd = buildBreadcrumbJsonLd([
  { name: "Home", path: "/" },
  { name: "Event logs", path: "/eventlogs" },
]);

const collectionJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  description: seoDescription,
  isPartOf: { "@type": "WebSite", url: SITE_URL },
  mainEntity: {
    "@type": "ItemList",
    itemListElement: events.map((event, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: `${SITE_URL}/eventlogs/${event.slug}`,
    })),
  },
  name: "Windows event log IDs",
};

const filterCategories = [
  { count: events.length, id: "all", label: "All" },
  ...groupedEvents.map(([category, items]) => ({
    count: items.length,
    id: getEventLogCategoryId(category),
    label: category,
  })),
];

const eventLogEventsJson = serializeJsonForScript(
  events.map((event) => ({
    c: getEventLogCategoryId(event.category),
    ch: event.channelLabel,
    cl: event.category,
    i: event.eventId,
    n: event.title,
    s: event.slug,
    t: [
      event.channel,
      event.logFile,
      ...event.maps.flatMap((map) => [
        map.provider,
        ...map.fields.map((field) => field.property),
        ...map.notes,
      ]),
    ].join(" "),
  }))
);
---


<Layout
  title="Windows Event Log IDs for Forensics"
  description={seoDescription}
>
  <script
    is:inline
    type="application/ld+json"
    set:html={serializeJsonForScript(breadcrumbJsonLd)}
    slot="head"
  />
  <script
    is:inline
    type="application/ld+json"
    set:html={serializeJsonForScript(collectionJsonLd)}
    slot="head"
  />

  <Header client:load currentPath={Astro.url.pathname} />

  <main id="main-content" class="relative flex-1" tabindex="-1">
    <div class="mx-auto max-w-6xl px-4 py-8">
      <nav class="mb-6 text-xs text-muted-foreground" aria-label="Breadcrumb">
        <ol class="flex items-center gap-1">
          <li>
            <a
              href="/"
              class="focus-ring rounded-sm px-1 transition-colors hover:text-foreground"
              >Home</a
            >
          </li>
          <li class="flex items-center gap-1">
            <span aria-hidden="true">/</span>
            <span class="px-1 text-foreground" aria-current="page">Event logs</span>
          </li>
        </ol>
      </nav>

      <header class="mb-8">
        <h1 class="mb-2 text-2xl font-semibold tracking-tight sm:text-3xl">
          Windows Event Logs
        </h1>
        <p class="max-w-3xl text-sm text-muted-foreground sm:text-base">
          <span class="font-medium text-foreground">{events.length}</span>
          {" event IDs from "}
          <span class="font-medium text-foreground">{channelCount}</span>
          {" event logs, with the fields EvtxECmd extracts and a sample event for each one."}
        </p>
      </header>

      <div class="sticky top-14 z-40 mb-6 bg-background py-3">
        <div class="relative mb-3">
          <svg
            aria-hidden="true"
            class="absolute top-1/2 left-3 h-4 w-4 -translate-y-1/2 text-muted-foreground"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.3-4.3"></path>
          </svg>
          <input
            id="eventlogs-search"
            type="search"
            autocomplete="off"
            spellcheck="false"
            placeholder="Search by event ID, name, channel, or provider"
            aria-label="Search event logs"
            class="h-10 w-full rounded-lg border border-input bg-card pr-9 pl-9 text-sm outline-none transition-colors placeholder:text-muted-foreground focus:border-primary focus:ring-2 focus:ring-ring/30 [&::-webkit-search-cancel-button]:hidden"
          />
          <button
            id="eventlogs-search-clear"
            type="button"
            aria-label="Clear search"
            class="absolute top-1/2 right-2 hidden -translate-y-1/2 rounded-md p-1 text-muted-foreground transition-colors hover:bg-overlay/[0.06] hover:text-foreground"
          >
            <svg
              aria-hidden="true"
              class="h-4 w-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M18 6 6 18"></path>
              <path d="m6 6 12 12"></path>
            </svg>
          </button>
        </div>
        <CategoryFilters
          client:idle
          basePath="/eventlogs"
          categories={filterCategories}
        />
      </div>

      <div id="eventlogs-empty" class="hidden py-16 text-center">
        <p class="text-sm text-muted-foreground">
          No events match "<span
            id="eventlogs-empty-query"
            class="font-medium text-foreground"></span>"
        </p>
        <a
          href="/eventlogs"
          class="mt-2 inline-block text-sm text-primary transition-colors hover:underline"
        >
          Clear search
        </a>
      </div>

      <div id="eventlogs-default-view" class="flex flex-col gap-8">
        {
          groupedEvents.map(([category, items]) => (
            <Panel headingId={`eventlogs-${getEventLogCategoryId(category)}`}>
              <Fragment slot="title">{category}</Fragment>
              <Fragment slot="subtitle">
                {`${items.length} ${items.length === 1 ? "event" : "events"}`}
              </Fragment>
              <a
                slot="actions"
                href={`/eventlogs?category=${getEventLogCategoryId(category)}`}
                class="panel-action focus-ring"
              >
                Filter
              </a>
              <ul class="divide-y divide-border">
                {items.map((event) => (
                  <li>
                    <a
                      href={`/eventlogs/${event.slug}`}
                      class="group flex items-baseline gap-4 px-4 py-2.5 transition-colors hover:bg-muted"
                    >
                      <span class="w-14 shrink-0 font-mono text-sm text-foreground tabular-nums group-hover:text-primary">
                        {event.eventId}
                      </span>
                      <span class="min-w-0 flex-1 truncate text-sm font-medium text-foreground group-hover:text-primary">
                        {event.title}
                      </span>
                      <span class="ml-auto hidden max-w-[40%] shrink-0 truncate font-mono text-xs text-muted-foreground sm:inline">
                        {event.channelLabel}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </Panel>
          ))
        }
      </div>

      <div id="eventlogs-filtered-view" class="hidden">
        <Panel headingId="eventlogs-filtered-title">
          <Fragment slot="title"><span id="eventlogs-filtered-label">Results</span></Fragment>
          <Fragment slot="subtitle">
            <span id="eventlogs-filter-status" aria-live="polite"></span>
          </Fragment>
          <ul class="divide-y divide-border" id="eventlogs-filtered-list"></ul>
        </Panel>
      </div>

      <p class="mt-16 border-t border-border pt-4 text-xs text-muted-foreground">
        <span>Source: </span>
        <a
          href={EVENTLOG_MAPS_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="focus-ring rounded-sm text-primary transition-colors hover:underline"
        >
          EvtxECmd maps (evtx/Maps)
          <span class="sr-only">(opens in new tab)</span>
        </a>
        {" by Eric Zimmerman and "}
        <a
          href={EVENTLOG_CONTRIBUTORS_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="focus-ring rounded-sm text-primary transition-colors hover:underline"
        >
          contributors
          <span class="sr-only">(opens in new tab)</span>
        </a>
        {", "}
        <a
          href={EVENTLOG_LICENSE_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="focus-ring rounded-sm text-primary transition-colors hover:underline"
        >
          MIT License
          <span class="sr-only">(opens in new tab)</span>
        </a>
      </p>
    </div>
  </main>

  <Footer />
</Layout>

<script
  is:inline
  type="application/json"
  id="eventlogs-events-data"
  set:html={eventLogEventsJson}
/>

<script is:inline>
(() => {
  if (window.__eventLogsPageBound) {
    return;
  }
  window.__eventLogsPageBound = true;

  const PAGE_PATH = "/eventlogs";
  const SEARCH_INPUT_ID = "eventlogs-search";
  const SEARCH_CLEAR_ID = "eventlogs-search-clear";
  const SEARCH_DEBOUNCE_MS = 150;
  let searchTimer = null;
  let eventLogEvents = null;

  const isEventLogsPage = () =>
    window.location.pathname.replace(/\.html$/u, "") === PAGE_PATH;

  const readEventLogEvents = () => {
    eventLogEvents ??= JSON.parse(
      document.getElementById("eventlogs-events-data")?.textContent || "[]"
    );
    return eventLogEvents;
  };

  const el = (tag, className, text) => {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  };

  const createRow = (event) => {
    const li = el("li");
    const link = el(
      "a",
      "group flex items-baseline gap-4 px-4 py-2.5 transition-colors hover:bg-muted"
    );
    link.href = `${PAGE_PATH}/${event.s}`;
    link.append(
      el(
        "span",
        "w-14 shrink-0 font-mono text-sm text-foreground tabular-nums group-hover:text-primary",
        String(event.i)
      ),
      el(
        "span",
        "min-w-0 flex-1 truncate text-sm font-medium text-foreground group-hover:text-primary",
        event.n
      ),
      el(
        "span",
        "ml-auto hidden max-w-[40%] shrink-0 truncate font-mono text-xs text-muted-foreground sm:inline",
        event.ch
      )
    );
    li.append(link);
    return li;
  };

  const updateFilterButtons = (activeId) => {
    for (const button of document.querySelectorAll(".category-filter-btn")) {
      if (button.getAttribute("data-filter-id") === activeId) {
        button.setAttribute("data-active", "true");
        button.scrollIntoView({ behavior: "auto", block: "nearest", inline: "center" });
      } else {
        button.removeAttribute("data-active");
      }
    }
  };

  const EVENT_ID_QUERY_PATTERN = /^\d+$/u;

  const matchesQuery = (event, needle) =>
    EVENT_ID_QUERY_PATTERN.test(needle)
      ? String(event.i).startsWith(needle)
      : [event.n, event.s, event.cl, event.ch, event.t]
          .join(" ")
          .toLowerCase()
          .includes(needle);

  const applyFilter = () => {
    if (!isEventLogsPage()) {
      return;
    }
    const params = new URLSearchParams(window.location.search);
    const query = params.get("q")?.trim() ?? "";
    const categoryId = params.get("category") ?? "";
    updateFilterButtons(categoryId || "all");

    const defaultView = document.getElementById("eventlogs-default-view");
    const filteredView = document.getElementById("eventlogs-filtered-view");
    const emptyState = document.getElementById("eventlogs-empty");
    const list = document.getElementById("eventlogs-filtered-list");
    if (!(defaultView && filteredView && emptyState && list)) {
      return;
    }

    const isFiltered = Boolean(query || categoryId);
    defaultView.classList.toggle("hidden", isFiltered);
    list.textContent = "";
    if (!isFiltered) {
      filteredView.classList.add("hidden");
      emptyState.classList.add("hidden");
      return;
    }

    const allEvents = readEventLogEvents();
    const needle = query.toLowerCase();
    const matches = allEvents.filter((event) =>
      query ? matchesQuery(event, needle) : event.c === categoryId
    );
    const hasMatches = matches.length > 0;

    filteredView.classList.toggle("hidden", !hasMatches);
    emptyState.classList.toggle("hidden", hasMatches);
    document.getElementById("eventlogs-empty-query").textContent = query;
    document.getElementById("eventlogs-filtered-label").textContent = query
      ? `Results for "${query}"`
      : (allEvents.find((event) => event.c === categoryId)?.cl ?? "Results");
    document.getElementById("eventlogs-filter-status").textContent =
      `${matches.length} of ${allEvents.length} events`;
    list.append(...matches.map(createRow));
  };

  const syncSearchClear = () => {
    const input = document.getElementById(SEARCH_INPUT_ID);
    document
      .getElementById(SEARCH_CLEAR_ID)
      ?.classList.toggle("hidden", !input?.value.trim());
  };

  const syncSearchInput = () => {
    const input = document.getElementById(SEARCH_INPUT_ID);
    if (!input || document.activeElement === input) {
      return;
    }
    input.value = new URLSearchParams(window.location.search).get("q") || "";
    syncSearchClear();
  };

  const submitSearch = () => {
    const input = document.getElementById(SEARCH_INPUT_ID);
    if (!input) {
      return;
    }
    const value = input.value.trim();
    history.replaceState(
      null,
      "",
      value ? `${PAGE_PATH}?q=${encodeURIComponent(value)}` : PAGE_PATH
    );
    applyFilter();
  };

  document.addEventListener("input", (event) => {
    if (event.target?.id !== SEARCH_INPUT_ID) {
      return;
    }
    syncSearchClear();
    clearTimeout(searchTimer);
    searchTimer = setTimeout(submitSearch, SEARCH_DEBOUNCE_MS);
  });

  document.addEventListener("keydown", (event) => {
    if (event.target?.id !== SEARCH_INPUT_ID || event.key !== "Enter") {
      return;
    }
    clearTimeout(searchTimer);
    submitSearch();
  });

  document.addEventListener("click", (event) => {
    if (!event.target?.closest?.(`#${SEARCH_CLEAR_ID}`)) {
      return;
    }
    const input = document.getElementById(SEARCH_INPUT_ID);
    if (!input) {
      return;
    }
    input.value = "";
    syncSearchClear();
    clearTimeout(searchTimer);
    submitSearch();
    input.focus();
  });

  const refreshPage = () => {
    eventLogEvents = null;
    syncSearchInput();
    applyFilter();
  };

  refreshPage();
  document.addEventListener("astro:page-load", refreshPage);
  window.addEventListener("popstate", refreshPage);
})();
</script>
