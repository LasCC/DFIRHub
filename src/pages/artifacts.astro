---
import { CategoryFilters } from "../components/artifacts/CategoryFilters";
import Footer from "../components/layout/Footer.astro";
import { Header } from "../components/layout/Header";
import Layout from "../layouts/Layout.astro";
import { getCategoryStyle } from "../lib/categoryStyles";
import { getCategories, getStats, loadAllTargets } from '../lib/kapefiles';
import type { KapeTarget } from '../lib/kapefiles';

const targets = loadAllTargets();
const categories = getCategories();
const stats = getStats();

// Scenario artifact mappings (resolved to exact slugs)
const scenarioArtifactAliases: Record<string, string[]> = {
  "anti-forensics": [
    "$mft",
    "$j",
    "$logfile",
    "recyclebin",
    "$usnjrnl",
    "vss",
    "thumbcache",
    "usn",
    "$mftmirr",
    "$sds",
    "$t",
    "recyclebin_datafiles",
    "recyclebin_infofiles",
    "xprestorepoints",
  ],
  "browser-forensics": [
    "chrome",
    "firefox",
    "edge",
    "ienetcache",
    "browsercache",
    "chromiumextensions",
    "browser",
    "bravebrowser",
    "opera",
    "internetexplorer",
    "vivaldi",
    "chromefilesystem",
    "edgefilesystem",
  ],
  execution: [
    "prefetch",
    "amcache",
    "shimcache",
    "srum",
    "appcompatpca",
    "userassist",
    "bam",
    "powershellconsole",
    "powershelltranscripts",
    "netclrusagelogs",
    "evidenceofexecution",
  ],
  "lateral-movement": [
    "rdpcache",
    "eventlogs-rdp",
    "eventlogs",
    "psexec",
    "bits",
    "smbclient",
    "networkprofiles",
    "rdp",
    "rdpjumplist",
    "rdplogs",
    "windowsnetwork",
    "windowsfirewall",
    "powershelltranscripts",
  ],
  persistence: [
    "scheduledtasks",
    "registryhivesuser",
    "registryhivessystem",
    "startupfolders",
    "services",
    "wbem",
    "mof",
    "registry",
    "grouppolicy",
    "startupinfo",
    "registryhivesother",
    "registryhivesmsixapps",
    "appxpackages",
  ],
  "user-activity": [
    "shellbags",
    "recentfilecache",
    "jumplists",
    "lnkfiles",
    "thumbcache",
    "wordwheelquery",
    "recent",
    "mru",
    "windowstimeline",
    "recentfolders",
    "windowsnotificationsdb",
    "officeautosave",
    "microsoftofficebackstage",
    "snippingtool",
  ],
};

const slugSet = new Set(targets.map((target) => target.slug.toLowerCase()));

function resolveScenarioSlugs(candidates: string[]): string[] {
  const resolved = new Set<string>();

  for (const candidate of candidates) {
    const normalized = candidate.toLowerCase();
    const options = [
      normalized,
      normalized.replaceAll("$", ""),
      normalized.startsWith("$") ? `-${normalized.slice(1)}` : normalized,
    ];

    for (const option of options) {
      if (slugSet.has(option)) {
        resolved.add(option);
      }
    }
  }

  return [...resolved];
}

const scenarioArtifacts = Object.fromEntries(
  Object.entries(scenarioArtifactAliases).map(([scenario, aliases]) => [
    scenario,
    resolveScenarioSlugs(aliases),
  ])
);

// Group targets by category
const targetsByCategory = categories.reduce(
  (acc, cat) => {
    acc[cat] = targets.filter((t) => t.category === cat);
    return acc;
  },
  {} as Record<string, KapeTarget[]>
);

// Serialize data for client-side filtering (short keys keep the JSON small)
const allTargetsJson = JSON.stringify(
  targets.map((t) => ({
    n: t.name,
    s: t.slug,
    c: t.category,
    i: t.isCompound,
    d: t.description || "",
    count: !t.isCompound
      ? t.targets.filter((e) => !e.path.endsWith(".tkape")).length
      : t.referencedTargets.length,
  }))
);
const scenarioArtifactsJson = JSON.stringify(scenarioArtifacts);

// Build filter categories for CategoryFilters component
const filterCategories = [
  { count: stats.total, id: "all", label: "All" },
  ...categories.map((cat) => ({
    count: stats.byCategory[cat] || 0,
    id: cat.toLowerCase(),
    label: cat,
  })),
];
---

<Layout
  title="All Artifacts"
  description="Browse all KAPE forensic artifact targets"
>
  <Header client:load currentPath={Astro.url.pathname} />

  <main id="main-content" class="flex-1 relative" tabindex="-1">
    <div class="mx-auto max-w-6xl px-4 py-8">
      <!-- Breadcrumb -->
      <nav class="mb-6 text-xs text-muted-foreground" aria-label="Breadcrumb">
        <ol class="flex items-center gap-1">
          <li>
            <a
              href="/"
              class="hover:text-foreground transition-colors focus-ring rounded-sm px-1"
              >Home</a
            >
          </li>
          <li class="flex items-center gap-1">
            <span aria-hidden="true">/</span>
            <span class="text-foreground px-1" aria-current="page"
              >Artifacts</span
            >
          </li>
        </ol>
      </nav>

      <!-- Header -->
      <header class="mb-8">
        <h1 class="text-2xl sm:text-3xl font-semibold mb-2 tracking-tight">
          All Artifacts
        </h1>
        <p class="text-sm sm:text-base text-muted-foreground">
          Browse <span class="font-medium text-foreground">{stats.total}</span> KAPE
          forensic artifact targets
        </p>
      </header>

      <!-- Active Filter Banner (hidden by default, shown via JS) -->
      <div id="filter-banner" class="hidden mb-6 p-3 sm:p-4 rounded-xl glass-subtle">
        <div class="flex items-center justify-between gap-2">
          <div class="flex items-center gap-1.5 sm:gap-3 min-w-0">
            <span class="text-xs sm:text-sm text-muted-foreground shrink-0">Filtered by:</span>
            <span
              id="filter-label"
              class="text-xs sm:text-sm font-semibold text-primary truncate"
            ></span>
            <span
              id="filter-count"
              class="text-xs text-muted-foreground shrink-0"
            ></span>
          </div>
          <a
            href="/artifacts"
            class="text-xs text-muted-foreground hover:text-foreground transition-colors flex items-center gap-1 shrink-0"
          >
            Clear filter
            <svg
              class="w-3 h-3"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12"
              />
            </svg>
          </a>
        </div>
      </div>

      <!-- Category Filter (sticky below header) -->
      <div class="sticky top-14 z-40 -mx-4 px-4 py-3 bg-background border-b border-border mb-8">
        <CategoryFilters client:idle categories={filterCategories} />
      </div>

      <!-- Default View: Targets by Category (hidden when filtered) -->
      <div id="default-view">
        {categories.map((category) => {
                        const style = getCategoryStyle(category);
                        return (
                            <section
                                class="category-section mb-12"
                                data-category={category.toLowerCase()}
                                aria-labelledby={"category-" + category.toLowerCase()}
                            >
                                <div class="flex items-center justify-between mb-5">
                                    <h2
                                        id={"category-" + category.toLowerCase()}
                                        class="text-sm font-medium flex items-center gap-3"
                                    >
                                        <span class={`w-2 h-2 rounded-full ${style.accent}`}></span>
                                        <span class="text-foreground">{category}</span>
                                        <span class={`text-xs ${style.text}`}>
                                            {targetsByCategory[category].length}
                                        </span>
                                    </h2>
                                    <a
                                        href={"/artifacts?category=" + category.toLowerCase()}
                                        class="text-xs text-muted-foreground hover:text-primary transition-colors focus-ring rounded-sm px-2 py-1 flex items-center gap-1"
                                    >
                                        View all
                                        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                                        </svg>
                                    </a>
                                </div>
                                <div class="grid grid-cols-1 lg:grid-cols-2 gap-x-6 gap-y-0.5">
                                    {targetsByCategory[category]
                                        .slice(0, 8)
                                        .map((target) => (
                                            <a
                                                href={"/artifact/" + target.slug}
                                                class="artifact-row group flex items-baseline gap-3 rounded-md px-3 py-2 transition-colors hover:bg-overlay/[0.04] focus-ring"
                                            >
                                                <span class="text-sm font-medium text-foreground group-hover:text-primary transition-colors shrink-0">
                                                    {target.name}
                                                </span>
                                                <span class="hidden sm:block text-sm text-muted-foreground truncate flex-1">
                                                    {target.description || "No description available"}
                                                </span>
                                                <span class="ml-auto sm:ml-0 text-xs text-muted-foreground tabular-nums shrink-0">
                                                    {!target.isCompound
                                                        ? target.targets.filter((e) => !e.path.endsWith(".tkape")).length + " paths"
                                                        : target.referencedTargets.length + " targets"}
                                                </span>
                                            </a>
                                        ))}
                                </div>
                                {targetsByCategory[category].length > 8 && (
                                    <div class="mt-4 text-center">
                                        <a
                                            href={"/artifacts?category=" + category.toLowerCase()}
                                            class="inline-flex items-center gap-2 text-xs text-muted-foreground hover:text-foreground transition-colors px-4 py-2 rounded-full border border-overlay/[0.04] hover:border-overlay/[0.08] hover:bg-overlay/[0.02]"
                                        >
                                            <span>+{targetsByCategory[category].length - 8} more in {category}</span>
                                            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                                            </svg>
                                        </a>
                                    </div>
                                )}
                            </section>
                        );
                    })}
      </div>

      <!-- Filtered View: rendered client-side when a filter is active -->
      <div id="filtered-view" class="hidden">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3"></div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .artifact-card {
    will-change: transform, box-shadow;
  }

  .artifact-card:hover {
    transform: translateY(-2px);
  }
</style>

<script is:inline define:vars={{ allTargetsJson, scenarioArtifactsJson }}>
  const allTargets = JSON.parse(allTargetsJson);
  const scenarioArtifacts = JSON.parse(scenarioArtifactsJson);

  // Category label colors, mirroring src/lib/categoryStyles.ts (no imports in inline scripts)
  const categoryTextClasses = {
    Antivirus: "text-red-700 dark:text-red-400",
    Apps: "text-emerald-700 dark:text-emerald-400",
    Browsers: "text-orange-700 dark:text-orange-400",
    Compound: "text-cyan-700 dark:text-cyan-400",
    Logs: "text-yellow-700 dark:text-yellow-400",
    P2P: "text-purple-700 dark:text-purple-400",
    Windows: "text-blue-700 dark:text-blue-400",
  };
  const defaultTextClass = "text-zinc-600 dark:text-zinc-400";

  function el(tag, className, text) {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  }

  // Builds the same card markup the filtered view previously shipped as static HTML
  function createCard(t) {
    const a = el(
      "a",
      "filtered-card artifact-card group rounded-xl border border-overlay/[0.06] bg-overlay/[0.02] transition-all duration-300 hover:border-overlay/[0.12] hover:bg-overlay/[0.05]"
    );
    a.href = "/artifact/" + t.s;

    const inner = el("div", "p-4");
    const head = el("div", "flex items-start justify-between gap-2 mb-2");
    head.appendChild(
      el(
        "h3",
        "text-sm font-medium text-foreground group-hover:text-primary transition-colors truncate",
        t.n
      )
    );
    if (t.i) {
      head.appendChild(
        el(
          "span",
          "shrink-0 px-2 py-0.5 text-xs uppercase tracking-wider font-medium text-cyan-700 dark:text-cyan-400 bg-cyan-500/10 border border-cyan-500/20 rounded-full",
          "collection"
        )
      );
    }
    inner.appendChild(head);
    inner.appendChild(
      el(
        "p",
        "text-xs text-muted-foreground line-clamp-2 mb-3 leading-relaxed",
        t.d || "No description available"
      )
    );
    const footer = el("div", "flex items-center justify-between text-xs");
    footer.appendChild(
      el(
        "span",
        "uppercase tracking-wider font-medium " +
          (categoryTextClasses[t.c] || defaultTextClass),
        t.c
      )
    );
    footer.appendChild(
      el(
        "span",
        "text-muted-foreground",
        t.count + (t.i ? " targets" : " paths")
      )
    );
    inner.appendChild(footer);
    a.appendChild(inner);
    return a;
  }

  // Scenario labels for display
  const scenarioLabels = {
    "anti-forensics": "Data Recovery",
    "browser-forensics": "Browser Forensics",
    execution: "Program Execution",
    "lateral-movement": "Lateral Movement",
    persistence: "Persistence",
    "user-activity": "User Activity",
  };

  function updateFilterButtons(activeId) {
    const buttons = document.querySelectorAll(".category-filter-btn");
    let activeButton = null;

    buttons.forEach((btn) => {
      const filterId = btn.getAttribute("data-filter-id");
      if (filterId === activeId) {
        btn.setAttribute("data-active", "true");
        activeButton = btn;
      } else {
        btn.removeAttribute("data-active");
      }
    });

    if (activeButton) {
      activeButton.scrollIntoView({
        behavior: "auto",
        block: "nearest",
        inline: "center",
      });
    }
  }

  function applyFilter() {
    // Parse URL parameters fresh each time
    const params = new URLSearchParams(window.location.search);
    const categoryParam = params.get("category");
    const filterParam = params.get("filter");
    const scenarioParam = params.get("scenario");
    const qParam = params.get("q");

    // Query DOM elements fresh each time (for view transitions)
    const filterBanner = document.querySelector("#filter-banner");
    const filterLabel = document.querySelector("#filter-label");
    const filterCount = document.querySelector("#filter-count");
    const defaultView = document.querySelector("#default-view");
    const filteredView = document.querySelector("#filtered-view");

    // Determine which filter is active and update buttons
    const activeFilterId = categoryParam || filterParam || "all";
    updateFilterButtons(activeFilterId);

    const matchingSlugs = new Set();
    let label = "";
    let isFiltered = false;

    if (qParam) {
      // Free-text search via ?q= param (from the homepage search form)
      isFiltered = true;
      label = `"${qParam}"`;
      const needle = qParam.toLowerCase();
      allTargets.forEach((t) => {
        if (
          t.n.toLowerCase().includes(needle) ||
          t.s.toLowerCase().includes(needle)
        ) {
          matchingSlugs.add(t.s.toLowerCase());
        }
      });
    } else if (categoryParam) {
      // Category filter via ?category= param
      isFiltered = true;
      label = categoryParam.charAt(0).toUpperCase() + categoryParam.slice(1);
      allTargets.forEach((t) => {
        if (t.c.toLowerCase() === categoryParam.toLowerCase()) {
          matchingSlugs.add(t.s.toLowerCase());
        }
      });
    } else if (filterParam) {
      isFiltered = true;
      label = filterParam.charAt(0).toUpperCase() + filterParam.slice(1);
      allTargets.forEach((t) => {
        if (t.c.toLowerCase() === filterParam.toLowerCase()) {
          matchingSlugs.add(t.s.toLowerCase());
        }
      });
    } else if (scenarioParam && scenarioArtifacts[scenarioParam]) {
      isFiltered = true;
      label = scenarioLabels[scenarioParam] || scenarioParam;
      const scenarioSlugs = scenarioArtifacts[scenarioParam];
      allTargets.forEach((t) => {
        const slugLower = t.s.toLowerCase();
        if (scenarioSlugs.includes(slugLower)) {
          matchingSlugs.add(slugLower);
        }
      });
    }

    if (
      filterBanner &&
      filterLabel &&
      filterCount &&
      defaultView &&
      filteredView
    ) {
      if (isFiltered) {
        // Show filter banner
        filterBanner.classList.remove("hidden");
        filterLabel.textContent = label;
        filterCount.textContent = `(${matchingSlugs.size} artifacts)`;

        // Switch views and render matching cards client-side
        defaultView.classList.add("hidden");
        filteredView.classList.remove("hidden");

        const grid = filteredView.firstElementChild;
        grid.textContent = "";
        allTargets.forEach((t) => {
          if (matchingSlugs.has(t.s.toLowerCase())) {
            grid.appendChild(createCard(t));
          }
        });
      } else {
        // No filter - show default view
        filterBanner.classList.add("hidden");
        defaultView.classList.remove("hidden");
        filteredView.classList.add("hidden");
        filteredView.firstElementChild.textContent = "";
      }
    }
  }

  // Apply filter on initial load and view transitions
  applyFilter();
  document.addEventListener("astro:page-load", applyFilter);
</script>
