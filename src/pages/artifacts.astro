---
import { CategoryFilters } from "../components/artifacts/CategoryFilters";
import Footer from "../components/layout/Footer.astro";
import { Header } from "../components/layout/Header";
import Layout from "../layouts/Layout.astro";
import { getCategoryStyle } from "../lib/categoryStyles";
import { getCategories, getStats, loadAllTargets } from '../lib/kapefiles';
import type { KapeTarget } from '../lib/kapefiles';

const targets = loadAllTargets();
const categories = getCategories();
const stats = getStats();

// Scenario artifact mappings (resolved to exact slugs)
const scenarioArtifactAliases: Record<string, string[]> = {
  "anti-forensics": [
    "$mft",
    "$j",
    "$logfile",
    "recyclebin",
    "$usnjrnl",
    "vss",
    "thumbcache",
    "usn",
    "$mftmirr",
    "$sds",
    "$t",
    "recyclebin_datafiles",
    "recyclebin_infofiles",
    "xprestorepoints",
  ],
  "browser-forensics": [
    "chrome",
    "firefox",
    "edge",
    "ienetcache",
    "browsercache",
    "chromiumextensions",
    "browser",
    "bravebrowser",
    "opera",
    "internetexplorer",
    "vivaldi",
    "chromefilesystem",
    "edgefilesystem",
  ],
  execution: [
    "prefetch",
    "amcache",
    "shimcache",
    "srum",
    "appcompatpca",
    "userassist",
    "bam",
    "powershellconsole",
    "powershelltranscripts",
    "netclrusagelogs",
    "evidenceofexecution",
  ],
  "lateral-movement": [
    "rdpcache",
    "eventlogs-rdp",
    "eventlogs",
    "psexec",
    "bits",
    "smbclient",
    "networkprofiles",
    "rdp",
    "rdpjumplist",
    "rdplogs",
    "windowsnetwork",
    "windowsfirewall",
    "powershelltranscripts",
  ],
  persistence: [
    "scheduledtasks",
    "registryhivesuser",
    "registryhivessystem",
    "startupfolders",
    "services",
    "wbem",
    "mof",
    "registry",
    "grouppolicy",
    "startupinfo",
    "registryhivesother",
    "registryhivesmsixapps",
    "appxpackages",
  ],
  "user-activity": [
    "shellbags",
    "recentfilecache",
    "jumplists",
    "lnkfiles",
    "thumbcache",
    "wordwheelquery",
    "recent",
    "mru",
    "windowstimeline",
    "recentfolders",
    "windowsnotificationsdb",
    "officeautosave",
    "microsoftofficebackstage",
    "snippingtool",
  ],
};

const slugSet = new Set(targets.map((target) => target.slug.toLowerCase()));

function resolveScenarioSlugs(candidates: string[]): string[] {
  const resolved = new Set<string>();

  for (const candidate of candidates) {
    const normalized = candidate.toLowerCase();
    const options = [
      normalized,
      normalized.replaceAll("$", ""),
      normalized.startsWith("$") ? `-${normalized.slice(1)}` : normalized,
    ];

    for (const option of options) {
      if (slugSet.has(option)) {
        resolved.add(option);
      }
    }
  }

  return [...resolved];
}

const scenarioArtifacts = Object.fromEntries(
  Object.entries(scenarioArtifactAliases).map(([scenario, aliases]) => [
    scenario,
    resolveScenarioSlugs(aliases),
  ])
);

// Group targets by category
const targetsByCategory = categories.reduce(
  (acc, cat) => {
    acc[cat] = targets.filter((t) => t.category === cat);
    return acc;
  },
  {} as Record<string, KapeTarget[]>
);

// Serialize data for client-side filtering (short keys keep the JSON small)
const allTargetsJson = JSON.stringify(
  targets.map((t) => ({
    n: t.name,
    s: t.slug,
    c: t.category,
    i: t.isCompound,
    d: t.description || "",
    count: !t.isCompound
      ? t.targets.filter((e) => !e.path.endsWith(".tkape")).length
      : t.referencedTargets.length,
  }))
);
const scenarioArtifactsJson = JSON.stringify(scenarioArtifacts);

// Build filter categories for CategoryFilters component
const filterCategories = [
  { count: stats.total, id: "all", label: "All" },
  ...categories.map((cat) => ({
    count: stats.byCategory[cat] || 0,
    id: cat.toLowerCase(),
    label: cat,
  })),
];
---

<Layout
  title="All Artifacts"
  description="Browse all KAPE forensic artifact targets"
>
  <Header client:load currentPath={Astro.url.pathname} />

  <main id="main-content" class="flex-1 relative" tabindex="-1">
    <div class="mx-auto max-w-6xl px-4 py-8">
      <!-- Breadcrumb -->
      <nav class="mb-6 text-xs text-muted-foreground" aria-label="Breadcrumb">
        <ol class="flex items-center gap-1">
          <li>
            <a
              href="/"
              class="hover:text-foreground transition-colors focus-ring rounded-sm px-1"
              >Home</a
            >
          </li>
          <li class="flex items-center gap-1">
            <span aria-hidden="true">/</span>
            <span class="text-foreground px-1" aria-current="page"
              >Artifacts</span
            >
          </li>
        </ol>
      </nav>

      <!-- Header -->
      <header class="mb-8">
        <h1 class="text-2xl sm:text-3xl font-semibold mb-2 tracking-tight">
          All Artifacts
        </h1>
        <p class="text-sm sm:text-base text-muted-foreground">
          Browse <span class="font-medium text-foreground">{stats.total}</span> KAPE
          forensic artifact targets
        </p>
      </header>

      <!-- Category Filter (sticky below header) -->
      <div class="sticky top-14 z-40 py-3 bg-background mb-6">
        <div class="relative mb-3">
          <svg
            aria-hidden="true"
            class="h-4 w-4 absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.3-4.3"></path>
          </svg>
          <input
            id="artifacts-search"
            type="search"
            data-search-input
            autocomplete="off"
            spellcheck="false"
            placeholder="Search artifacts by name, category, or description"
            aria-label="Search artifacts"
            class="h-10 w-full rounded-lg border border-input bg-card pl-9 pr-9 text-sm outline-none transition-colors placeholder:text-muted-foreground focus:border-primary focus:ring-2 focus:ring-ring/30 [&::-webkit-search-cancel-button]:hidden"
          />
          <button
            id="artifacts-search-clear"
            type="button"
            aria-label="Clear search"
            class="hidden absolute right-2 top-1/2 -translate-y-1/2 rounded-md p-1 text-muted-foreground transition-colors hover:bg-overlay/[0.06] hover:text-foreground"
          >
            <svg
              aria-hidden="true"
              class="h-4 w-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M18 6 6 18"></path>
              <path d="m6 6 12 12"></path>
            </svg>
          </button>
        </div>
        <CategoryFilters client:idle categories={filterCategories} />
        <p
          id="filter-status"
          class="hidden mt-3 text-sm text-muted-foreground tabular-nums"
          aria-live="polite"
        ></p>
      </div>

      <!-- No results state (shown via JS when a search matches nothing) -->
      <div id="filter-empty" class="hidden py-16 text-center">
        <p class="text-sm text-muted-foreground">
          No artifacts match "<span id="filter-empty-query" class="font-medium text-foreground"></span>"
        </p>
        <a
          href="/artifacts"
          class="mt-2 inline-block text-sm text-primary transition-colors hover:underline"
        >
          Clear search
        </a>
      </div>

      <!-- Default View: Targets by Category (hidden when filtered) -->
      <div id="default-view">
        {categories.map((category) => {
                        const style = getCategoryStyle(category);
                        return (
                            <section
                                class="category-section mb-10"
                                data-category={category.toLowerCase()}
                                aria-labelledby={"category-" + category.toLowerCase()}
                            >
                                <h2
                                    id={"category-" + category.toLowerCase()}
                                    class="mb-3 flex items-center gap-2.5 text-sm font-medium"
                                >
                                    <span class={`h-2 w-2 rounded-full ${style.accent}`}></span>
                                    <span class="text-foreground">{category}</span>
                                    <span class="font-normal text-muted-foreground tabular-nums">
                                        {targetsByCategory[category].length}
                                    </span>
                                </h2>
                                <ul class="divide-y divide-border overflow-hidden rounded-lg border border-border bg-card">
                                    {targetsByCategory[category]
                                        .slice(0, 6)
                                        .map((target) => {
                                            const pathCount = target.targets.filter((e) => !e.path.endsWith(".tkape")).length;
                                            return (
                                                <li>
                                                    <a
                                                        href={"/artifact/" + target.slug}
                                                        class="artifact-row group flex items-baseline gap-4 px-4 py-2.5 transition-colors hover:bg-muted"
                                                    >
                                                        <span class="w-48 shrink-0 truncate text-sm font-medium text-foreground group-hover:text-primary sm:w-56">
                                                            {target.name}
                                                        </span>
                                                        <span class="hidden min-w-0 flex-1 truncate text-sm text-muted-foreground sm:block">
                                                            {target.description || "No description available"}
                                                        </span>
                                                        <span class="ml-auto shrink-0 text-xs text-muted-foreground tabular-nums">
                                                            {target.isCompound
                                                                ? target.referencedTargets.length + " targets"
                                                                : pathCount + (pathCount === 1 ? " path" : " paths")}
                                                        </span>
                                                    </a>
                                                </li>
                                            );
                                        })}
                                    {targetsByCategory[category].length > 6 && (
                                        <li>
                                            <a
                                                href={"/artifacts?category=" + category.toLowerCase()}
                                                class="flex items-center justify-between px-4 py-2.5 text-sm text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
                                            >
                                                <span>View all {targetsByCategory[category].length} in {category}</span>
                                                <svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="m9 18 6-6-6-6" />
                                                </svg>
                                            </a>
                                        </li>
                                    )}
                                </ul>
                            </section>
                        );
                    })}
      </div>

      <!-- Filtered View: rendered client-side when a filter is active -->
      <div id="filtered-view" class="hidden">
        <ul class="divide-y divide-border overflow-hidden rounded-lg border border-border bg-card"></ul>
      </div>
    </div>
  </main>

  <Footer />
</Layout>


<script is:inline define:vars={{ allTargetsJson, scenarioArtifactsJson }}>
  const allTargets = JSON.parse(allTargetsJson);
  const scenarioArtifacts = JSON.parse(scenarioArtifactsJson);

  function el(tag, className, text) {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  }

  const categoryDotClasses = {
    Antivirus: "bg-red-600",
    Apps: "bg-emerald-600",
    Browsers: "bg-orange-600",
    Compound: "bg-cyan-600",
    Logs: "bg-yellow-700",
    P2P: "bg-purple-600",
    Windows: "bg-blue-600",
  };

  function createRow(t) {
    const li = el("li");
    const a = el(
      "a",
      "group flex items-baseline gap-4 px-4 py-2.5 transition-colors hover:bg-muted"
    );
    a.href = "/artifact/" + t.s;

    const name = el("span", "flex w-48 shrink-0 items-center gap-2 sm:w-56");
    const dot = el(
      "span",
      "h-2 w-2 shrink-0 self-center rounded-full " +
        (categoryDotClasses[t.c] || "bg-zinc-500")
    );
    dot.title = t.c;
    name.appendChild(dot);
    name.appendChild(
      el(
        "span",
        "truncate text-sm font-medium text-foreground group-hover:text-primary",
        t.n
      )
    );
    a.appendChild(name);
    a.appendChild(
      el(
        "span",
        "hidden min-w-0 flex-1 truncate text-sm text-muted-foreground sm:block",
        t.d || "No description available"
      )
    );
    a.appendChild(
      el(
        "span",
        "ml-auto shrink-0 text-xs text-muted-foreground tabular-nums",
        t.count + (t.i ? " targets" : t.count === 1 ? " path" : " paths")
      )
    );
    li.appendChild(a);
    return li;
  }

  // Scenario labels for display
  const scenarioLabels = {
    "anti-forensics": "Data Recovery",
    "browser-forensics": "Browser Forensics",
    execution: "Program Execution",
    "lateral-movement": "Lateral Movement",
    persistence: "Persistence",
    "user-activity": "User Activity",
  };

  function updateFilterButtons(activeId) {
    const buttons = document.querySelectorAll(".category-filter-btn");
    let activeButton = null;

    buttons.forEach((btn) => {
      const filterId = btn.getAttribute("data-filter-id");
      if (filterId === activeId) {
        btn.setAttribute("data-active", "true");
        activeButton = btn;
      } else {
        btn.removeAttribute("data-active");
      }
    });

    if (activeButton) {
      activeButton.scrollIntoView({
        behavior: "auto",
        block: "nearest",
        inline: "center",
      });
    }
  }

  function applyFilter() {
    // Parse URL parameters fresh each time
    const params = new URLSearchParams(window.location.search);
    const categoryParam = params.get("category");
    const filterParam = params.get("filter");
    const scenarioParam = params.get("scenario");
    const qParam = params.get("q");

    // Query DOM elements fresh each time (for view transitions)
    const filterStatus = document.querySelector("#filter-status");
    const filterEmpty = document.querySelector("#filter-empty");
    const filterEmptyQuery = document.querySelector("#filter-empty-query");
    const defaultView = document.querySelector("#default-view");
    const filteredView = document.querySelector("#filtered-view");

    // Determine which filter is active and update buttons
    const activeFilterId = categoryParam || filterParam || "all";
    updateFilterButtons(activeFilterId);

    const matchingSlugs = new Set();
    let label = "";
    let isFiltered = false;

    if (qParam) {
      // Free-text search via ?q= param (homepage search, in-page search bar)
      isFiltered = true;
      label = `"${qParam}"`;
      const needle = qParam.toLowerCase();
      allTargets.forEach((t) => {
        if (
          t.n.toLowerCase().includes(needle) ||
          t.s.toLowerCase().includes(needle) ||
          t.c.toLowerCase().includes(needle) ||
          (t.d || "").toLowerCase().includes(needle)
        ) {
          matchingSlugs.add(t.s.toLowerCase());
        }
      });
    } else if (categoryParam) {
      // Category filter via ?category= param
      isFiltered = true;
      label = categoryParam.charAt(0).toUpperCase() + categoryParam.slice(1);
      allTargets.forEach((t) => {
        if (t.c.toLowerCase() === categoryParam.toLowerCase()) {
          matchingSlugs.add(t.s.toLowerCase());
        }
      });
    } else if (filterParam) {
      isFiltered = true;
      label = filterParam.charAt(0).toUpperCase() + filterParam.slice(1);
      allTargets.forEach((t) => {
        if (t.c.toLowerCase() === filterParam.toLowerCase()) {
          matchingSlugs.add(t.s.toLowerCase());
        }
      });
    } else if (scenarioParam && scenarioArtifacts[scenarioParam]) {
      isFiltered = true;
      label = scenarioLabels[scenarioParam] || scenarioParam;
      const scenarioSlugs = scenarioArtifacts[scenarioParam];
      allTargets.forEach((t) => {
        const slugLower = t.s.toLowerCase();
        if (scenarioSlugs.includes(slugLower)) {
          matchingSlugs.add(slugLower);
        }
      });
    }

    if (defaultView && filteredView) {
      if (isFiltered) {
        const hasMatches = matchingSlugs.size > 0;

        // Show match count at the end of the sticky bar; prefix with the
        // scenario label since the pills alone don't convey a scenario filter.
        // Hidden on zero matches - the empty state below says it already.
        if (filterStatus) {
          if (hasMatches) {
            filterStatus.textContent =
              (scenarioParam && label ? label + " · " : "") +
              matchingSlugs.size +
              " of " +
              allTargets.length;
            filterStatus.classList.remove("hidden");
          } else {
            filterStatus.classList.add("hidden");
            filterStatus.textContent = "";
          }
        }

        // Switch views and render matching cards client-side
        defaultView.classList.add("hidden");
        filteredView.classList.toggle("hidden", !hasMatches);

        if (hasMatches) {
          const grid = filteredView.firstElementChild;
          grid.textContent = "";
          allTargets.forEach((t) => {
            if (matchingSlugs.has(t.s.toLowerCase())) {
              grid.appendChild(createRow(t));
            }
          });
        }

        // Show an empty state when a search matches nothing
        if (filterEmpty && filterEmptyQuery) {
          filterEmpty.classList.toggle("hidden", hasMatches);
          if (!hasMatches) {
            filterEmptyQuery.textContent = qParam || "";
          }
        }
      } else {
        // No filter - show default view
        if (filterStatus) {
          filterStatus.classList.add("hidden");
          filterStatus.textContent = "";
        }
        defaultView.classList.remove("hidden");
        filteredView.classList.add("hidden");
        filteredView.firstElementChild.textContent = "";
        if (filterEmpty) {
          filterEmpty.classList.add("hidden");
        }
      }
    }
  }

  // Apply filter on initial load, view transitions, and history navigation
  applyFilter();
  document.addEventListener("astro:page-load", applyFilter);
  window.addEventListener("popstate", applyFilter);

  // ── In-page search bar ─────────────────────────────────────────────
  const searchInput = document.getElementById("artifacts-search");
  const searchClear = document.getElementById("artifacts-search-clear");
  let searchTimer = null;

  function syncSearchClear() {
    if (searchClear && searchInput) {
      searchClear.classList.toggle("hidden", !searchInput.value.trim());
    }
  }

  function syncSearchInput() {
    if (!searchInput || document.activeElement === searchInput) {
      return;
    }
    const params = new URLSearchParams(window.location.search);
    searchInput.value = params.get("q") || "";
    syncSearchClear();
  }

  function submitSearch() {
    const value = (searchInput ? searchInput.value : "").trim();
    if (value) {
      history.replaceState(null, "", "/artifacts?q=" + encodeURIComponent(value));
    } else {
      history.replaceState(null, "", "/artifacts");
    }
    applyFilter();
  }

  if (searchInput) {
    searchInput.addEventListener("input", () => {
      syncSearchClear();
      clearTimeout(searchTimer);
      searchTimer = setTimeout(submitSearch, 150);
    });
    searchInput.addEventListener("keydown", (e) => {
      if (e.key === "Enter") {
        clearTimeout(searchTimer);
        submitSearch();
      }
    });
  }

  if (searchClear && searchInput) {
    searchClear.addEventListener("click", () => {
      searchInput.value = "";
      syncSearchClear();
      clearTimeout(searchTimer);
      submitSearch();
      searchInput.focus();
    });
  }

  document.addEventListener("astro:page-load", syncSearchInput);
  syncSearchInput();
</script>
