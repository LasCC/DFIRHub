---
import { ScriptBuilder } from "../components/builder/ScriptBuilder";
import Footer from "../components/layout/Footer.astro";
import { Header } from "../components/layout/Header";
import Layout from "../layouts/Layout.astro";
import { getCategories, loadAllTargets } from '../lib/kapefiles';
import {
  buildBreadcrumbJsonLd,
  SITE_NAME,
  SITE_URL,
} from '../lib/seo';

// Load data at build time
const allTargets = loadAllTargets();
const categories = getCategories();

const seoDescription =
  "Free KAPE script builder. Select forensic artifact targets and export a ready-to-run KAPE command, PowerShell script or batch file for evidence collection.";
const breadcrumbJsonLd = buildBreadcrumbJsonLd([
  { name: "Home", path: "/" },
  { name: "Script Builder", path: "/builder" },
]);
const applicationJsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  applicationCategory: "SecurityApplication",
  description: seoDescription,
  isAccessibleForFree: true,
  name: "KAPE Script Builder",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  operatingSystem: "Web",
  provider: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
  url: `${SITE_URL}/builder`,
};
---

<Layout title="KAPE Script Builder" description={seoDescription}>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbJsonLd)}
    slot="head"
  />
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(applicationJsonLd)}
    slot="head"
  />
  <Header client:load currentPath={Astro.url.pathname} />

  <main id="main-content" class="flex-1 relative" tabindex="-1">
    <div class="mx-auto max-w-6xl px-4 py-8">
      <!-- Breadcrumb -->
      <nav class="mb-6 text-xs text-muted-foreground" aria-label="Breadcrumb">
        <ol class="flex items-center gap-1">
          <li>
            <a
              href="/"
              class="hover:text-foreground transition-colors focus-ring rounded-sm px-1"
              >Home</a
            >
          </li>
          <li class="flex items-center gap-1">
            <span aria-hidden="true">/</span>
            <span class="text-foreground px-1" aria-current="page">Builder</span>
          </li>
        </ol>
      </nav>

      <!-- Header -->
      <header class="mb-8">
        <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight mb-2">Script Builder</h1>
        <p class="text-sm sm:text-base text-muted-foreground">
          Build custom collection scripts by selecting targets. Export as KAPE
          command, PowerShell, or batch file.
        </p>
      </header>

      <!-- Script Builder Component -->
      <ScriptBuilder
        client:load
        allTargets={allTargets}
        categories={categories}
      />
    </div>
  </main>

  <Footer />
</Layout>
