---
import { ScriptBuilder } from "../components/builder/ScriptBuilder";
import Footer from "../components/layout/Footer.astro";
import { Header } from "../components/layout/Header";
import Layout from "../layouts/Layout.astro";
import type { BuilderModule, BuilderTarget } from "../lib/builder/config";
import { loadAllModules } from "../lib/kapeModules";
import { getCategories, getDirectReferenceSlugs, loadAllTargets } from '../lib/kapefiles';
import {
  buildBreadcrumbJsonLd,
  serializeJsonForScript,
  SITE_NAME,
  SITE_URL,
} from '../lib/seo';

const builderTargets: BuilderTarget[] = loadAllTargets().map((target) => ({
  category: target.category,
  childSlugs: getDirectReferenceSlugs(target),
  description: target.description,
  entries: target.targets
    .filter((entry) => !entry.path.endsWith(".tkape"))
    .map(({ name, category, path, fileMask, recursive }) => ({
      category,
      fileMask,
      name,
      path,
      recursive,
    })),
  isCompound: target.isCompound,
  kapeName: target.sourceFile.replace(/\.tkape$/, ""),
  name: target.name,
  slug: target.slug,
}));
const builderModules: BuilderModule[] = loadAllModules().map((module) => ({
  category: module.category,
  description: module.description,
  exportFormats: module.exportFormats,
  folder: module.folder,
  isCompound: module.isCompound,
  name: module.name,
  referencedModules: module.referencedModules,
}));
const moduleFolders = [
  ...new Set(builderModules.map((module) => module.folder)),
].toSorted();

const seoDescription =
  "Free KAPE command builder. Start from an incident scenario, pick targets and modules, set containers and SFTP, S3 or Azure upload, and export a KAPE command, _kape.cli batch file or a PowerShell fallback script.";
const breadcrumbJsonLd = buildBreadcrumbJsonLd([
  { name: "Home", path: "/" },
  { name: "KAPE Command Builder", path: "/builder" },
]);
const applicationJsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  applicationCategory: "SecurityApplication",
  description: seoDescription,
  isAccessibleForFree: true,
  name: "KAPE Command Builder",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  operatingSystem: "Web",
  provider: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
  url: `${SITE_URL}/builder`,
};
---

<Layout title="KAPE Command Builder" description={seoDescription}>
  <script
    is:inline
    type="application/ld+json"
    set:html={serializeJsonForScript(breadcrumbJsonLd)}
    slot="head"
  />
  <script
    is:inline
    type="application/ld+json"
    set:html={serializeJsonForScript(applicationJsonLd)}
    slot="head"
  />
  <Header client:load currentPath={Astro.url.pathname} />

  <main id="main-content" class="flex-1 relative" tabindex="-1">
    <div class="mx-auto max-w-6xl px-4 py-6">
      <!-- Breadcrumb -->
      <nav class="mb-4 text-xs text-muted-foreground page-enter" aria-label="Breadcrumb">
        <ol class="flex items-center gap-1">
          <li>
            <a
              href="/"
              class="hover:text-foreground transition-colors focus-ring rounded-sm px-1"
              >Home</a
            >
          </li>
          <li class="flex items-center gap-1">
            <span aria-hidden="true">/</span>
            <span class="text-foreground px-1" aria-current="page">Builder</span>
          </li>
        </ol>
      </nav>

      <!-- Header -->
      <header class="mb-6 max-w-2xl page-enter [animation-delay:50ms]">
        <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight mb-1.5">KAPE command builder</h1>
        <p class="text-sm text-muted-foreground">
          Pick what to collect, then export a KAPE command or a ready-to-run
          script
        </p>
      </header>

      <!-- Script Builder Component -->
      <div class="page-enter [animation-delay:100ms]">
      <ScriptBuilder
        client:load
        moduleFolders={moduleFolders}
        modules={builderModules}
        targetCategories={getCategories()}
        targets={builderTargets}
      />
      </div>
    </div>
  </main>

  <Footer />
</Layout>
