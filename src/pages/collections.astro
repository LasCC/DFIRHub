---
import Footer from "../components/layout/Footer.astro";
import { Header } from "../components/layout/Header";
import Panel from "../components/ui/Panel.astro";
import Layout from "../layouts/Layout.astro";
import { getCompoundTargets, resolveCompoundReferences } from '../lib/kapefiles';
import { buildBreadcrumbJsonLd, serializeJsonForScript } from '../lib/seo';

const collections = getCompoundTargets();

// Sort collections by number of referenced targets (most comprehensive first)
const sortedCollections = [...collections].toSorted(
  (a, b) => b.referencedTargets.length - a.referencedTargets.length
);

// Highlight featured collections
const featuredNames = [
  "KapeTriage",
  "BasicCollection",
  "SANS_Triage",
  "EvidenceOfExecution",
];
const featured = sortedCollections.filter((c) =>
  featuredNames.some((name) =>
    c.name.toLowerCase().includes(name.toLowerCase())
  )
);

const breadcrumbJsonLd = buildBreadcrumbJsonLd([
  { name: "Home", path: "/" },
  { name: "Collections", path: "/collections" },
]);
const seoDescription = `Browse ${collections.length} pre-built KAPE triage collections, such as KapeTriage and SANS Triage, for rapid forensic acquisition during incident response.`;
---

<Layout title="KAPE Triage Collections" description={seoDescription}>
  <script
    is:inline
    type="application/ld+json"
    set:html={serializeJsonForScript(breadcrumbJsonLd)}
    slot="head"
  />
  <Header client:load currentPath={Astro.url.pathname} />

  <main id="main-content" class="flex-1 relative" tabindex="-1">
    <div class="mx-auto max-w-6xl px-4 py-8">
      <!-- Breadcrumb -->
      <nav
        class="mb-6 text-xs text-muted-foreground animate-in"
        aria-label="Breadcrumb"
      >
        <ol class="flex items-center gap-1">
          <li>
            <a
              href="/"
              class="hover:text-foreground transition-colors focus-ring rounded-sm px-1"
              >Home</a
            >
          </li>
          <li class="flex items-center gap-1">
            <span aria-hidden="true">/</span>
            <span class="text-foreground px-1" aria-current="page"
              >Collections</span
            >
          </li>
        </ol>
      </nav>

      <!-- Header -->
      <header class="mb-8 animate-in" style="animation-delay: 50ms;">
        <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight mb-2">Triage Collections</h1>
        <p class="text-sm sm:text-base text-muted-foreground">
          <span class="font-medium text-foreground">{collections.length}</span> pre-built KAPE
          compound targets for rapid forensic acquisition
        </p>
      </header>

      <!-- Info Box -->
      <div
        class="mb-8 p-4 border border-cyan-500/30 bg-card bg-linear-to-b from-cyan-500/5 to-cyan-500/5 rounded-lg animate-in"
        style="animation-delay: 100ms;"
      >
        <p class="text-sm text-muted-foreground">
          <span class="font-medium text-cyan-700 dark:text-cyan-400">Compound targets</span> combine multiple
          individual targets into a single collection. Use these for
          comprehensive triage acquisition with a single KAPE command.
        </p>
      </div>

      <!-- Featured Collections -->
      {featured.length > 0 && (
        <div class="mb-8 animate-in" style="animation-delay: 150ms;">
          <Panel headingId="featured-heading">
            <Fragment slot="title">Featured collections</Fragment>
            <Fragment slot="subtitle">{featured.length} starting points for triage</Fragment>
            <div class="grid grid-cols-1 gap-px bg-border md:grid-cols-2 md:[&>*:last-child:nth-child(odd)]:col-span-2">
              {featured.map((collection) => {
                const resolved = resolveCompoundReferences(collection);
                const totalPaths = resolved.reduce(
                  (acc, t) =>
                    acc + t.targets.filter((e) => !e.path.endsWith(".tkape")).length,
                  0,
                );
                return (
                  <a
                    href={`/artifact/${collection.slug}`}
                    class="group focus-ring block bg-background p-5 transition-colors hover:bg-muted"
                  >
                    <h3 class="mb-2 text-base font-medium text-cyan-700 transition-colors group-hover:text-cyan-600 dark:text-cyan-400 dark:group-hover:text-cyan-300">
                      {collection.name}
                    </h3>
                    <p class="mb-4 line-clamp-2 text-sm text-muted-foreground">
                      {collection.description}
                    </p>
                    <div class="flex items-center gap-4 text-xs text-muted-foreground">
                      <span>
                        <span class="font-medium text-cyan-700 dark:text-cyan-400">
                          {collection.referencedTargets.length}
                        </span>{" "}
                        targets
                      </span>
                      <span>
                        <span class="font-medium text-cyan-700 dark:text-cyan-400">
                          {resolved.length}
                        </span>{" "}
                        resolved
                      </span>
                      <span>
                        <span class="font-medium text-cyan-700 dark:text-cyan-400">
                          {totalPaths}
                        </span>{" "}
                        paths
                      </span>
                    </div>
                  </a>
                );
              })}
            </div>
          </Panel>
        </div>
      )}

      <!-- All Collections -->
      <div class="animate-in" style="animation-delay: 200ms;">
        <Panel headingId="all-heading">
          <Fragment slot="title">All collections</Fragment>
          <Fragment slot="subtitle">Pre-built compound targets</Fragment>
          <ul class="divide-y divide-border">
            {sortedCollections.map((collection) => (
              <li>
                <a
                  href={`/artifact/${collection.slug}`}
                  class="group focus-ring flex items-baseline gap-4 px-4 py-2.5 transition-colors hover:bg-muted"
                >
                  <span class="w-48 shrink-0 truncate text-sm font-medium text-foreground transition-colors group-hover:text-cyan-700 dark:group-hover:text-cyan-400 sm:w-56">
                    {collection.name}
                  </span>
                  <span class="hidden min-w-0 flex-1 truncate text-sm text-muted-foreground sm:block">
                    {collection.description || "Compound target collection"}
                  </span>
                  <span class="hidden w-52 shrink-0 truncate text-right text-xs text-muted-foreground lg:block" title={collection.author}>
                    by {collection.author}
                  </span>
                  <span class="ml-auto w-20 shrink-0 text-right text-xs tabular-nums text-cyan-700 dark:text-cyan-400">
                    {`${collection.referencedTargets.length} ${collection.referencedTargets.length === 1 ? "target" : "targets"}`}
                  </span>
                </a>
              </li>
            ))}
          </ul>
          <Fragment slot="footer">
            <span class="tabular-nums">{sortedCollections.length} collections</span>
            <span>Sorted by number of targets</span>
          </Fragment>
        </Panel>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .animate-in {
    opacity: 0;
    animation: animate-in 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes animate-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
