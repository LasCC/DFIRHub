---
import Footer from "../components/layout/Footer.astro";
import { Header } from "../components/layout/Header";
import { HomeSearch } from "../components/search/HomeSearch";
import type { HomeSearchItem } from "../components/search/HomeSearch";
import Layout from "../layouts/Layout.astro";
import { getIndividualTargets, getStats, getTargetBySlug } from "../lib/kapefiles";

const stats = getStats();

// Curated entry points shown as one-click links under the search bar
const popularSlugs = [
  "anydesk",
  "screenconnect",
  "teamviewerlogs",
  "prefetch",
  "amcache",
  "chrome",
  "srum",
  "eventlogs",
  "jumplists",
];

const popular: HomeSearchItem[] = popularSlugs.flatMap((slug) => {
  const target = getTargetBySlug(slug);
  return target
    ? [
        {
          n: target.name,
          s: target.slug,
          c: target.category,
          d: "",
          p: target.targets.filter((entry) => !entry.path.endsWith(".tkape"))
            .length,
        },
      ]
    : [];
});

// Compact artifact index for client-side suggestions (short keys keep the
// serialized payload small)
const searchIndex: HomeSearchItem[] = getIndividualTargets().map((target) => ({
  n: target.name,
  s: target.slug,
  c: target.category,
  d: target.description || "",
  p: target.targets.filter((entry) => !entry.path.endsWith(".tkape")).length,
}));

const tools = [
  {
    title: "Artifacts",
    description: `Browse ${stats.total} Windows forensic artifacts with collection paths, categories, and documentation.`,
    href: "/artifacts",
    icon: "search",
  },
  {
    title: "Collections",
    description:
      "Pre-built collection profiles for common investigation and triage scenarios.",
    href: "/collections",
    icon: "layers",
  },
  {
    title: "Script Builder",
    description:
      "Pick the artifacts you need and generate a ready-to-run KAPE collection script.",
    href: "/builder",
    icon: "wrench",
  },
  {
    title: "Sigma Converter",
    description:
      "Convert Sigma detection rules to SIEM query languages, entirely in your browser.",
    href: "/converter",
    icon: "sigma",
  },
];
---

<Layout title="DFIRHub">
  <Header client:load currentPath={Astro.url.pathname} />

  <main id="main-content" tabindex="-1">
    <div class="mx-auto max-w-6xl px-4">
      <!-- Hero -->
      <section class="mx-auto max-w-2xl pt-16 pb-12 text-center sm:pt-24 sm:pb-16">
        <h1 class="text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
          Search Windows forensic artifacts
        </h1>
        <p class="mx-auto mt-3 max-w-xl text-sm text-muted-foreground sm:text-base">
          Browse {stats.total} KAPE artifact definitions, build collection
          scripts, and convert Sigma rules. All in one place.
        </p>

        <div class="mt-8">
          <HomeSearch client:load data={searchIndex} popular={popular} />
        </div>

        <p class="mt-4 flex flex-wrap items-center justify-center gap-x-2 gap-y-1 text-xs text-muted-foreground">
          <span>Popular:</span>
          {popular.map((item, i) => (
            <>
              {i > 0 && <span aria-hidden="true">·</span>}
              <a
                href={`/artifact/${item.s}`}
                class="transition-colors hover:text-primary hover:underline underline-offset-4"
              >
                {item.n}
              </a>
            </>
          ))}
        </p>
      </section>

      <!-- Tools -->
      <section class="border-t border-border py-12 sm:py-16">
        <h2 class="mb-6 text-lg font-semibold tracking-tight sm:text-xl">
          Tools
        </h2>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          {tools.map((tool) => (
            <a
              href={tool.href}
              class="glass-subtle group rounded-lg p-5 transition-colors hover:border-primary/50 sm:p-6"
            >
              <div class="mb-3 flex h-9 w-9 items-center justify-center rounded-md border border-border text-muted-foreground">
                {tool.icon === "search" && (
                  <svg aria-hidden="true" class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"></circle>
                    <path d="m21 21-4.3-4.3"></path>
                  </svg>
                )}
                {tool.icon === "layers" && (
                  <svg aria-hidden="true" class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z" />
                    <path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65" />
                    <path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65" />
                  </svg>
                )}
                {tool.icon === "wrench" && (
                  <svg aria-hidden="true" class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m15 12-8.373 8.373a1 1 0 1 1-3-3L12 9" />
                    <path d="m18 15 4-4" />
                    <path d="m21.5 11.5-1.914-1.914A2 2 0 0 1 19 8.172V7l-2.26-2.26a6 6 0 0 0-4.202-1.756L9 2.96l.92.82A6.18 6.18 0 0 1 12 8.4V10l2 2h1.172a2 2 0 0 1 1.414.586L18.5 14.5" />
                  </svg>
                )}
                {tool.icon === "sigma" && (
                  <svg aria-hidden="true" class="h-4.5 w-4.5" viewBox="155 155 750 625" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                    <path d="m890.394412 165c3.019653 25.589448-5.253407 50.2282-24.819179 73.916253-19.565772 23.688054-45.907539 35.53208-79.025312 35.53208l-62.977337.363397c39.393202 52.779296 59.977836 120.64775 53.603978 194.68827-14.47716 168.170707-162.549778 304.5-330.729454 304.5s-292.780187-136.329293-278.30303-304.5c14.477156-168.170706 162.549776-304.5 330.729452-304.5zm-401.090784 111.166667c-106.780747 0-200.795108 86.558282-209.986954 193.333334s69.91959 193.333333 176.700337 193.333333c106.780746 0 200.795108-86.558281 209.986952-193.333333 9.191849-106.775052-69.919588-193.333334-176.700335-193.333334z" />
                  </svg>
                )}
              </div>
              <h3 class="text-base font-medium text-foreground">{tool.title}</h3>
              <p class="mt-1 text-sm leading-relaxed text-muted-foreground">
                {tool.description}
              </p>
            </a>
          ))}
        </div>
      </section>
    </div>
  </main>

  <Footer />
</Layout>
