---
import { HeroConsole } from "../components/home/HeroConsole";
import QuestionIndex from "../components/home/QuestionIndex.astro";
import ToolShowcase from "../components/home/ToolShowcase.astro";
import Footer from "../components/layout/Footer.astro";
import { Header } from "../components/layout/Header";
import { HomeSearch } from "../components/search/HomeSearch";
import type { HomeSearchItem } from "../components/search/HomeSearch";
import Layout from "../layouts/Layout.astro";
import { getHomepageData } from "../lib/homepage";
import { getIndividualTargets, getTargetBySlug } from "../lib/kapefiles";

const {
  totalTargets,
  distinctPathCount,
  consolePreviews,
  questions,
  categoryBars,
  collection,
  builderLines,
  sigma,
} = getHomepageData();

const popularSlugs = [
  "anydesk",
  "screenconnect",
  "teamviewerlogs",
  "prefetch",
  "amcache",
  "chrome",
  "srum",
  "eventlogs",
  "jumplists",
];

const popular: HomeSearchItem[] = popularSlugs.flatMap((slug) => {
  const target = getTargetBySlug(slug);
  return target
    ? [
        {
          n: target.name,
          s: target.slug,
          c: target.category,
          d: "",
          p: target.targets.filter((entry) => !entry.path.endsWith(".tkape"))
            .length,
        },
      ]
    : [];
});

const searchIndex: HomeSearchItem[] = getIndividualTargets().map((target) => ({
  n: target.name,
  s: target.slug,
  c: target.category,
  d: target.description || "",
  p: target.targets.filter((entry) => !entry.path.endsWith(".tkape")).length,
}));
---

<Layout title="DFIRHub">
  <Header client:load currentPath={Astro.url.pathname} />

  <main id="main-content" tabindex="-1">
    <div class="mx-auto max-w-6xl px-4">
      <section class="pt-12 pb-10 sm:pt-16 sm:pb-14">
        <h1 class="max-w-4xl text-4xl leading-[1.04] font-semibold tracking-[-0.035em] text-balance sm:text-5xl lg:text-[3.75rem]">
          Where the evidence lives, and the command to collect it
        </h1>

        <div class="mt-10 grid grid-cols-1 items-start gap-10 lg:grid-cols-12 lg:gap-12">
          <div class="lg:col-span-5">
            <p class="max-w-md text-base text-muted-foreground">
              Search {totalTargets} KAPE targets that cover{" "}
              {distinctPathCount} paths on disk. Copy a ready-to-run command,
              build a collection script, or convert a Sigma rule for your SIEM.
            </p>

            <div class="mt-8">
              <HomeSearch client:load data={searchIndex} popular={popular} />
            </div>

            <div class="mt-4 flex flex-wrap items-center gap-2">
              <span class="text-sm text-muted-foreground">Popular</span>
              {popular.map((item) => (
                <a
                  href={`/artifact/${item.s}`}
                  class="rounded-md border border-border bg-card px-2.5 py-1 text-sm text-muted-foreground transition-colors hover:border-primary hover:text-foreground"
                >
                  {item.n}
                </a>
              ))}
            </div>
          </div>

          <div class="lg:col-span-7">
            <HeroConsole client:load previews={consolePreviews} />
          </div>
        </div>
      </section>

      <QuestionIndex questions={questions} />

      <ToolShowcase
        totalTargets={totalTargets}
        categoryBars={categoryBars}
        collection={collection}
        builderLines={builderLines}
        sigma={sigma}
      />
    </div>
  </main>

  <Footer />
</Layout>
