---
import Footer from "../components/layout/Footer.astro";
import { Header } from "../components/layout/Header";
import Layout from "../layouts/Layout.astro";
import { getCategoryStyle } from "../lib/categoryStyles";
import { getCategories, getStats } from "../lib/kapefiles";

const stats = getStats();

const categories = [
  { id: "all", label: "All", count: stats.total },
  ...getCategories().map((cat) => ({
    id: cat.toLowerCase(),
    label: cat,
    count: stats.byCategory[cat] || 0,
  })),
];

// Investigation scenarios (filtered views on the artifacts page)
const scenarios = [
  { id: "lateral-movement", title: "Lateral Movement" },
  { id: "browser-forensics", title: "Browser Forensics" },
  { id: "persistence", title: "Persistence" },
  { id: "execution", title: "Program Execution" },
  { id: "user-activity", title: "User Activity" },
  { id: "anti-forensics", title: "Data Recovery" },
];

const tools = [
  {
    title: "Artifacts",
    description: `Browse ${stats.total} Windows forensic artifacts with collection paths, categories, and documentation.`,
    href: "/artifacts",
    icon: "search",
  },
  {
    title: "Collections",
    description:
      "Pre-built collection profiles for common investigation and triage scenarios.",
    href: "/collections",
    icon: "layers",
  },
  {
    title: "Script Builder",
    description:
      "Pick the artifacts you need and generate a ready-to-run KAPE collection script.",
    href: "/builder",
    icon: "wrench",
  },
  {
    title: "Sigma Converter",
    description:
      "Convert Sigma detection rules to SIEM query languages, entirely in your browser.",
    href: "/converter",
    icon: "sigma",
  },
];

const features = [
  {
    title: "Always current",
    description:
      "Artifact definitions sync weekly from the KapeFiles repository, so paths and targets stay up to date.",
  },
  {
    title: "Runs in your browser",
    description:
      "No server, no telemetry. Searches and rule conversions never leave your machine.",
  },
  {
    title: "Built for investigations",
    description:
      "Go from artifact lookup to a ready KAPE collection script in seconds.",
  },
];
---

<Layout title="DFIRHub">
  <Header client:load currentPath={Astro.url.pathname} />

  <main id="main-content" tabindex="-1">
    <div class="mx-auto max-w-6xl px-4">
      <!-- Hero -->
      <section class="py-14 sm:py-20">
        <h1
          class="max-w-2xl text-3xl font-semibold tracking-tight sm:text-4xl"
        >
          Search Windows forensic artifacts
        </h1>
        <p class="mt-3 max-w-xl text-sm text-muted-foreground sm:text-base">
          Reference {stats.total} KAPE artifact definitions, build collection
          scripts, and convert Sigma rules — all in one place.
        </p>

        <!-- Search -->
        <form
          action="/artifacts"
          method="get"
          role="search"
          class="mt-8 max-w-xl"
        >
          <label for="home-search" class="sr-only">Search artifacts</label>
          <div
            class="flex h-12 items-center gap-3 rounded-lg border border-input bg-background px-4 transition-colors focus-within:border-primary"
          >
            <svg
              aria-hidden="true"
              class="h-4 w-4 shrink-0 text-muted-foreground"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.3-4.3"></path>
            </svg>
            <input
              id="home-search"
              name="q"
              type="search"
              data-search-input
              autocomplete="off"
              spellcheck="false"
              placeholder="Search artifacts, e.g. prefetch, amcache, srum"
              class="h-full flex-1 bg-transparent text-sm outline-none placeholder:text-muted-foreground sm:text-base"
            />
            <kbd class="kbd" aria-hidden="true">/</kbd>
          </div>
        </form>

        <!-- Category quick links -->
        <nav aria-label="Browse by category" class="mt-8">
          <p class="mb-3 text-sm text-muted-foreground">Browse by category</p>
          <ul class="flex flex-wrap gap-2">
            {categories.map((cat) => {
              const style = getCategoryStyle(cat.label);
              return (
                <li>
                  <a
                    href={cat.id === "all" ? "/artifacts" : `/artifacts?category=${cat.id}`}
                    class="inline-flex items-center gap-2 rounded-full border border-border bg-card px-3 py-1.5 text-sm text-muted-foreground transition-colors hover:border-primary/50 hover:text-foreground"
                  >
                    {cat.id !== "all" && (
                      <span
                        class:list={["h-1.5 w-1.5 rounded-full", style.accent]}
                        aria-hidden="true"
                      />
                    )}
                    {cat.label}
                    <span class="text-xs tabular-nums text-muted-foreground">
                      {cat.count}
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </nav>

        <!-- Scenario quick links -->
        <nav aria-label="Investigate by scenario" class="mt-6">
          <p class="text-sm text-muted-foreground">
            Investigate by scenario:{" "}
            {scenarios.map((scenario, i) => (
              <>
                <a
                  href={`/artifacts?scenario=${scenario.id}`}
                  class="text-foreground underline-offset-4 transition-colors hover:text-primary hover:underline"
                >
                  {scenario.title}
                </a>
                {i < scenarios.length - 1 && (
                  <span aria-hidden="true" class="mx-1 text-muted-foreground">
                    ·
                  </span>
                )}
              </>
            ))}
          </p>
        </nav>
      </section>

      <!-- Tools -->
      <section class="border-t border-border py-12 sm:py-16">
        <h2 class="mb-6 text-lg font-semibold tracking-tight sm:text-xl">
          Tools
        </h2>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          {tools.map((tool) => (
            <a
              href={tool.href}
              class="glass-subtle group rounded-lg p-5 transition-colors hover:border-primary/50 sm:p-6"
            >
              <div class="mb-3 flex h-9 w-9 items-center justify-center rounded-md border border-border text-muted-foreground">
                {tool.icon === "search" && (
                  <svg aria-hidden="true" class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"></circle>
                    <path d="m21 21-4.3-4.3"></path>
                  </svg>
                )}
                {tool.icon === "layers" && (
                  <svg aria-hidden="true" class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z" />
                    <path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65" />
                    <path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65" />
                  </svg>
                )}
                {tool.icon === "wrench" && (
                  <svg aria-hidden="true" class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m15 12-8.373 8.373a1 1 0 1 1-3-3L12 9" />
                    <path d="m18 15 4-4" />
                    <path d="m21.5 11.5-1.914-1.914A2 2 0 0 1 19 8.172V7l-2.26-2.26a6 6 0 0 0-4.202-1.756L9 2.96l.92.82A6.18 6.18 0 0 1 12 8.4V10l2 2h1.172a2 2 0 0 1 1.414.586L18.5 14.5" />
                  </svg>
                )}
                {tool.icon === "sigma" && (
                  <svg aria-hidden="true" class="h-4.5 w-4.5" viewBox="155 155 750 625" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                    <path d="m890.394412 165c3.019653 25.589448-5.253407 50.2282-24.819179 73.916253-19.565772 23.688054-45.907539 35.53208-79.025312 35.53208l-62.977337.363397c39.393202 52.779296 59.977836 120.64775 53.603978 194.68827-14.47716 168.170707-162.549778 304.5-330.729454 304.5s-292.780187-136.329293-278.30303-304.5c14.477156-168.170706 162.549776-304.5 330.729452-304.5zm-401.090784 111.166667c-106.780747 0-200.795108 86.558282-209.986954 193.333334s69.91959 193.333333 176.700337 193.333333c106.780746 0 200.795108-86.558281 209.986952-193.333333 9.191849-106.775052-69.919588-193.333334-176.700335-193.333334z" />
                  </svg>
                )}
              </div>
              <h3 class="text-base font-medium text-foreground">{tool.title}</h3>
              <p class="mt-1 text-sm leading-relaxed text-muted-foreground">
                {tool.description}
              </p>
            </a>
          ))}
        </div>
      </section>

      <!-- Why DFIRHub -->
      <section class="border-t border-border py-12 sm:py-16">
        <h2 class="mb-6 text-lg font-semibold tracking-tight sm:text-xl">
          Why DFIRHub
        </h2>
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-3 sm:gap-8">
          {features.map((feature) => (
            <div>
              <h3 class="text-sm font-medium text-foreground sm:text-base">
                {feature.title}
              </h3>
              <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">
                {feature.description}
              </p>
            </div>
          ))}
        </div>
      </section>
    </div>
  </main>

  <Footer />
</Layout>
