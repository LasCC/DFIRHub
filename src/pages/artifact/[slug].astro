---
import {
  ArtifactBreadcrumb,
  ArtifactFooter,
  ArtifactHeader,
  ArtifactPageContainer,
} from "../../components/artifact/ArtifactContent";
import { ArrowRight, ArrowUpRight, Folder, Info, Tag, User, Users } from "lucide-react";
import { CategoryChip } from "../../components/artifact/CategoryChip";
import { CommandGenerator } from "../../components/artifact/CommandGenerator";
import { CyberChefLinks } from "../../components/artifact/CyberChefLinks";
import { PathBrowser } from "../../components/artifact/PathBrowser";
import Footer from "../../components/layout/Footer.astro";
import { Header } from "../../components/layout/Header";
import Panel from "../../components/ui/Panel.astro";
import Layout from "../../layouts/Layout.astro";
import { findCollectionsContaining, findTargetByReference, getCollectionMembers, getResolvedEntries, loadAllTargets, resolveCompoundReferences } from '../../lib/kapefiles';
import { isPerUserEntry } from '../../lib/kapeEntries';
import { builderHref } from '../../lib/builder/urlState';
import { parseReferenceLink } from '../../lib/referenceLinks';
import { artifactOgImagePath, artifactPath } from '../../lib/routes';
import type { KapeTarget } from '../../lib/kapefiles';
import { getEventLogEventsForKapeTarget } from '../../lib/eventlogs';
import { findRelatedArtifacts, getArtifactEvidence } from '../../lib/artifactEvidence';
import { getArtifactInsight, getParserModules, isThinArtifact } from '../../lib/artifactInsights';
import { getHivesForKapeTarget, getRegistryArtifactsForHives } from '../../lib/registry';
import {
  buildArtifactDescription,
  buildArtifactTitle,
  buildBreadcrumbJsonLd,
  getTargetDates,
  LOGO_URL,
  serializeJsonForScript,
  SITE_NAME,
  SITE_URL,
} from '../../lib/seo';

export async function getStaticPaths() {
  return loadAllTargets().map((target) => ({
    params: { slug: target.slug },
    props: { target },
  }));
}

interface Props {
  target: KapeTarget;
}

const { target } = Astro.props;

const resolvedTargets = target.isCompound ? getCollectionMembers(target) : undefined;
const resolvedEntries = getResolvedEntries(target);
const commandTarget = {
  entries: resolvedEntries,
  kapeName: target.kapeName,
  name: target.name,
};

const includedInCollections = findCollectionsContaining(target.slug);

const MAX_REGISTRY_LINKS = 16;
const registryHives = getHivesForKapeTarget(target.slug);
const registryArtifacts = getRegistryArtifactsForHives(registryHives);

const MAX_EVENTLOG_LINKS = 24;
const eventLogEvents = getEventLogEventsForKapeTarget(target.slug);

// Split documentation entries into URL references and free-text notes
const isUrl = (value: string) => /^https?:\/\//i.test(value);
const docReferences = target.documentation.filter(isUrl);
const docNotes = target.documentation.filter((entry) => !isUrl(entry));

// Group consecutive tab-separated log-like lines into code blocks,
// keeping prose lines as their own paragraphs. Tabs in .tkape comments
// are preserved by the parser, so their presence reliably marks samples.
type NoteBlock =
  | { type: "text"; value: string }
  | { type: "code"; lines: string[] };

const noteBlocks: NoteBlock[] = [];
for (const entry of docNotes) {
  const isLog = entry.includes("\t");
  const last = noteBlocks.at(-1);
  if (isLog && last?.type === "code") {
    last.lines.push(entry);
  } else if (isLog) {
    noteBlocks.push({ type: "code", lines: [entry] });
  } else {
    noteBlocks.push({ type: "text", value: entry });
  }
}

const MAX_SUMMARY_FILES = 6;
const MAX_SUMMARY_LOCATIONS = 3;
const evidence = getArtifactEvidence(target);
const summaryFiles = target.isCompound ? [] : evidence.keyFiles.slice(0, MAX_SUMMARY_FILES);
const summaryLocations = target.isCompound ? [] : evidence.locations.slice(0, MAX_SUMMARY_LOCATIONS);
const hiddenLocationCount = Math.max(0, evidence.locations.length - MAX_SUMMARY_LOCATIONS);
const relatedArtifacts = findRelatedArtifacts(target);
const insight = getArtifactInsight(target.slug);
const parserModules = insight ? getParserModules(insight) : [];
const builderUrl = builderHref({
  modules: parserModules.map((module) => module.name),
  targets: [target.slug],
});
const shouldNoindex = isThinArtifact(target);
const showDescription =
  Boolean(target.description) &&
  target.description.trim().toLowerCase() !== target.name.toLowerCase();

const pathCount = resolvedEntries.length;
const searchKind = target.isCompound ? "Collection" : "Artifact";
const MAX_FILE_TYPES = 3;
const LONG_DESCRIPTION_LENGTH = 160;
const numberFormat = new Intl.NumberFormat("en-US");
const hasLongDescription = target.description.length > LONG_DESCRIPTION_LENGTH;
const allFileTypes = target.isCompound
  ? []
  : [
      ...new Set(
        resolvedEntries.flatMap((entry) => (entry.fileMask ? [entry.fileMask] : []))
      ),
    ];
const visibleFileTypes =
  allFileTypes.length <= MAX_FILE_TYPES ? allFileTypes : [];
const hasPerUserData = resolvedEntries.some(isPerUserEntry);

const MAX_INCLUDED_LINKS = 20;
const includedArtifacts = target.referencedTargets
  .slice(0, MAX_INCLUDED_LINKS)
  .map((reference) => {
    const found = findTargetByReference(reference);
    return {
      name: reference.replace(/\.tkape$/u, ""),
      pathCount: found ? getResolvedEntries(found).length : 0,
      slug: found?.slug,
    };
  });
const hiddenIncludedCount = Math.max(
  0,
  target.referencedTargets.length - MAX_INCLUDED_LINKS
);

const referenceLinks = docReferences.map((url) => parseReferenceLink(url));

const chipLinkClass =
  "inline-flex rounded-md border border-border bg-card px-2.5 py-1 text-sm text-muted-foreground transition-colors hover:border-primary hover:text-foreground";

const seoTitle = buildArtifactTitle(target);
const seoDescription = buildArtifactDescription(target);
const artifactUrl = `${SITE_URL}${artifactPath(target.slug)}`;
const socialImagePath = artifactOgImagePath(target.slug);
const socialImageAlt = `${target.name} forensic artifact and KAPE target on DFIRHub`;
const targetDates = getTargetDates(target);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  about: {
    "@type": "Thing",
    description: "Windows forensic artifact for incident response",
    name: "Digital Forensics",
  },
  author: {
    "@type": "Person",
    name: target.author,
  },
  description: seoDescription,
  headline: `${target.name} - Windows Forensic Artifact`.slice(0, 110),
  image: `${SITE_URL}${socialImagePath}`,
  inLanguage: "en",
  keywords: [
    `${target.name} forensic artifact`,
    "forensic artifact",
    "forensic artefact",
    "DFIR",
    target.category,
    "KAPE",
    "Windows forensics",
  ].join(", "),
  mainEntityOfPage: {
    "@id": artifactUrl,
    "@type": "WebPage",
  },
  publisher: {
    "@type": "Organization",
    logo: { "@type": "ImageObject", url: LOGO_URL },
    name: SITE_NAME,
    url: SITE_URL,
  },
  ...(targetDates && {
    dateModified: targetDates.modified,
    datePublished: targetDates.published,
  }),
};

const breadcrumbJsonLd = buildBreadcrumbJsonLd([
  { name: "Home", path: "/" },
  { name: "Artifacts", path: "/artifacts" },
  { name: target.category, path: `/category/${target.category.toLowerCase()}` },
  { name: target.name, path: `/artifact/${target.slug}` },
]);
---

<Layout
  title={seoTitle}
  description={seoDescription}
  type="article"
  image={socialImagePath}
  imageAlt={socialImageAlt}
  noindex={shouldNoindex}
>
  <script is:inline
    type="application/ld+json"
    set:html={serializeJsonForScript(jsonLd)}
    slot="head"
  />
  <script is:inline
    type="application/ld+json"
    set:html={serializeJsonForScript(breadcrumbJsonLd)}
    slot="head"
  />

  <Header client:load currentPath={Astro.url.pathname} />

  <main id="main-content" class="relative flex-1" tabindex="-1" data-pagefind-body>
    <span hidden data-pagefind-meta={`kind:${searchKind}`}></span>
    <span hidden data-pagefind-meta={`category:${target.category}`}></span>
    <span hidden data-pagefind-filter={`category:${target.category}`}></span>
    <span hidden data-pagefind-meta={`paths:${pathCount}`}></span>
    <span hidden data-pagefind-meta={`kapeName:${target.kapeName}`}></span>
    <div class="mx-auto max-w-6xl px-4 py-8 sm:py-10">
      <ArtifactPageContainer client:load>
        <ArtifactBreadcrumb className="mb-8 text-xs text-muted-foreground page-enter">
          <ol class="flex flex-wrap items-center gap-1" role="list" data-pagefind-ignore>
            <li>
              <a
                href="/"
                class="focus-ring rounded-sm px-1 transition-colors hover:text-foreground"
                >Home</a
              >
            </li>
            <li class="flex items-center gap-1">
              <span aria-hidden="true">/</span>
              <a
                href="/artifacts"
                class="focus-ring rounded-sm px-1 transition-colors hover:text-foreground"
                >Artifacts</a
              >
            </li>
            <li class="flex items-center gap-1">
              <span aria-hidden="true">/</span>
              <a
                href={"/category/" + target.category.toLowerCase()}
                class="focus-ring rounded-sm px-1 transition-colors hover:text-foreground"
              >
                {target.category}
              </a>
            </li>
            <li class="flex items-center gap-1">
              <span aria-hidden="true">/</span>
              <span class="px-1 text-foreground" aria-current="page"
                >{target.slug}</span
              >
            </li>
          </ol>
        </ArtifactBreadcrumb>

        <ArtifactHeader className="mb-12 page-enter [animation-delay:50ms]">
          <h1
            id="artifact-title"
            class="max-w-4xl text-4xl leading-[1.04] font-semibold tracking-[-0.035em] text-balance sm:text-5xl"
          >
            <span class="mb-3 block font-mono text-sm font-normal tracking-normal text-muted-foreground">
              {target.isCompound ? "KAPE triage collection" : "Windows forensic artifact"}
            </span>
            {target.name}
          </h1>
          {showDescription && (
            <p
              class:list={[
                "mt-4 whitespace-pre-line text-muted-foreground",
                hasLongDescription ? "max-w-3xl text-base" : "max-w-2xl text-lg",
              ]}
            >
              {target.description}
            </p>
          )}
          {summaryLocations.length > 0 && (
            <p class="mt-4 max-w-3xl text-sm leading-relaxed text-muted-foreground">
              {summaryFiles.length > 0 && (
                <Fragment>
                  Look for{" "}
                  {summaryFiles.map((file, index) => (
                    <Fragment>
                      {index > 0 && ", "}
                      <code class="font-mono text-foreground">{file}</code>
                    </Fragment>
                  ))}{" "}
                  in{" "}
                </Fragment>
              )}
              {summaryFiles.length === 0 && "Evidence lives in "}
              {summaryLocations.map((location, index) => (
                <Fragment>
                  {index > 0 && (index === summaryLocations.length - 1 && hiddenLocationCount === 0 ? " and " : ", ")}
                  <code class="font-mono break-words text-foreground">{location}</code>
                </Fragment>
              ))}
              {hiddenLocationCount > 0 && ` and ${hiddenLocationCount} more ${hiddenLocationCount === 1 ? "folder" : "folders"}`}.
            </p>
          )}
          <ul class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3 text-sm text-muted-foreground" data-pagefind-ignore>
            <li>
              <CategoryChip
                category={target.category}
                isCompound={target.isCompound}
              />
            </li>
            <li class="inline-flex items-center gap-1.5">
              <Folder aria-hidden="true" className="h-4 w-4" />
              <span>
                {numberFormat.format(pathCount)} {pathCount === 1 ? "path" : "paths"}
                {target.isCompound && ` from ${numberFormat.format(resolveCompoundReferences(target).length)} artifacts`}
              </span>
            </li>
            {visibleFileTypes.length > 0 && (
              <li class="flex flex-wrap items-center gap-1.5">
                {visibleFileTypes.map((fileType) => (
                  <code class="rounded border border-border bg-muted px-1.5 py-0.5 font-mono text-xs text-foreground">
                    {fileType}
                  </code>
                ))}
              </li>
            )}
            {hasPerUserData && (
              <li
                class="inline-flex items-center gap-1.5"
                title="Paths contain %user%, so every user profile is collected"
              >
                <Users aria-hidden="true" className="h-4 w-4" />
                Per-user data
              </li>
            )}
            <li class="inline-flex items-center gap-1.5">
              <Tag aria-hidden="true" className="h-4 w-4" />
              Version {target.version}
            </li>
            <li class="inline-flex items-center gap-1.5">
              <User aria-hidden="true" className="h-4 w-4" />
              {target.author}
            </li>
          </ul>
        </ArtifactHeader>

        <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 page-enter [animation-delay:100ms]">
          <div class="flex min-w-0 flex-col gap-8 lg:col-span-7">
            {insight && (
              <Panel headingId="insight-heading">
                <Fragment slot="title">What it shows</Fragment>
                <Fragment slot="subtitle">Investigation value and how to parse it</Fragment>
                <div class="space-y-4 p-5 text-sm leading-relaxed">
                  <p class="text-foreground">{insight.proves}</p>
                  {insight.tip && (
                    <div class="flex gap-3 rounded-lg border border-border bg-muted/50 px-3.5 py-3 text-muted-foreground">
                      <Info aria-hidden="true" className="mt-0.5 h-4 w-4 shrink-0 text-primary" />
                      <p>{insight.tip}</p>
                    </div>
                  )}
                </div>
                {parserModules.length > 0 && (
                  <ul class="divide-y divide-border border-t border-border">
                    {parserModules.map((module) => (
                      <li class="flex items-center justify-between gap-4 px-5 py-2.5">
                        <span class="min-w-0">
                          <span class="block font-mono text-sm text-foreground">{module.name}</span>
                          <span class="block text-xs text-muted-foreground">{module.description}</span>
                        </span>
                        <span class="shrink-0 text-xs text-muted-foreground">KAPE module</span>
                      </li>
                    ))}
                  </ul>
                )}
                {parserModules.length > 0 && (
                  <div class="panel-footer" data-pagefind-ignore>
                    <a href={builderUrl} class="focus-ring rounded-sm text-primary transition-colors hover:underline">
                      Collect and parse in the command builder
                    </a>
                  </div>
                )}
              </Panel>
            )}

            <div data-pagefind-ignore={target.isCompound ? "all" : undefined}>
              <PathBrowser
                client:idle
                target={target}
                resolvedTargets={resolvedTargets}
              />
            </div>

            {target.isCompound && (
              <Panel headingId="includes-heading">
                <Fragment slot="title">Includes {target.referencedTargets.length} targets</Fragment>
                <Fragment slot="subtitle">Each one is collected with this target</Fragment>
                <ul class="divide-y divide-border">
                  {includedArtifacts.map((included) => (
                    <li>
                      {included.slug ? (
                        <a
                          href={"/artifact/" + included.slug}
                          class="group flex items-center justify-between px-4 py-2.5 transition-colors hover:bg-muted"
                        >
                          <span class="text-sm">{included.name}</span>
                          <span data-pagefind-ignore class="inline-flex items-center gap-1 text-xs text-muted-foreground transition-colors group-hover:text-foreground">
                            {included.pathCount} {included.pathCount === 1 ? "path" : "paths"}
                            <ArrowRight aria-hidden="true" className="h-3 w-3" />
                          </span>
                        </a>
                      ) : (
                        <span class="block px-4 py-2.5 text-sm text-muted-foreground">
                          {included.name}
                        </span>
                      )}
                    </li>
                  ))}
                </ul>
                {hiddenIncludedCount > 0 && (
                  <Fragment slot="footer">
                    <span>and {hiddenIncludedCount} more</span>
                  </Fragment>
                )}
              </Panel>
            )}

            {docNotes.length > 0 && (
              <Panel headingId="notes-heading">
                <Fragment slot="title">Notes</Fragment>
                <div class="space-y-4 p-5 text-sm leading-relaxed text-foreground/80">
                  {noteBlocks.map((block) =>
                    block.type === "text" ? (
                      <p class="break-words">{block.value}</p>
                    ) : (
                      <pre class="scrollbar-thin overflow-x-auto rounded-lg border border-overlay/[0.06] bg-sunken px-3 py-2.5 text-xs leading-5 text-foreground/80"><code class="font-mono">{block.lines.join("\n")}</code></pre>
                    )
                  )}
                </div>
              </Panel>
            )}

            {referenceLinks.length > 0 && (
              <Panel headingId="references-heading">
                <Fragment slot="title">References</Fragment>
                <Fragment slot="subtitle">
                  {`${referenceLinks.length} ${referenceLinks.length === 1 ? "link" : "links"}`}
                </Fragment>
                <ul class="divide-y divide-border">
                  {referenceLinks.map((reference) => (
                    <li>
                      <a
                        href={reference.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="group focus-ring flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted"
                      >
                        <span class="min-w-0 truncate text-sm font-medium text-foreground group-hover:text-primary sm:w-64 sm:shrink-0" title={reference.host}>
                          {reference.host}
                        </span>
                        <span class="hidden min-w-0 flex-1 truncate text-xs text-muted-foreground sm:block">
                          {reference.detail}
                        </span>
                        <ArrowUpRight
                          aria-hidden="true"
                          className="ml-auto h-3.5 w-3.5 shrink-0 text-muted-foreground group-hover:text-primary"
                        />
                        <span class="sr-only" data-pagefind-ignore>(opens in new tab)</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </Panel>
            )}

            {relatedArtifacts.length > 0 && (
              <Panel headingId="related-heading">
                <Fragment slot="title">Related artifacts</Fragment>
                <Fragment slot="subtitle">Often collected in the same investigation</Fragment>
                <a
                  href={"/category/" + target.category.toLowerCase()}
                  slot="actions"
                  class="panel-action focus-ring"
                >
                  All {target.category.toLowerCase()} artifacts
                </a>
                <ul class="divide-y divide-border" data-pagefind-ignore>
                  {relatedArtifacts.map((related) => (
                    <li>
                      <a
                        href={"/artifact/" + related.slug}
                        class="group flex items-center justify-between gap-4 px-4 py-2.5 transition-colors hover:bg-muted"
                      >
                        <span class="min-w-0">
                          <span class="block text-sm text-foreground">{related.name}</span>
                          {related.description && related.description !== related.name && (
                            <span class="block truncate text-xs text-muted-foreground">{related.description}</span>
                          )}
                        </span>
                        <ArrowRight aria-hidden="true" className="h-3 w-3 shrink-0 text-muted-foreground transition-colors group-hover:text-foreground" />
                      </a>
                    </li>
                  ))}
                </ul>
              </Panel>
            )}
          </div>

          <aside
            aria-label="Collect and related information"
            data-pagefind-ignore
            class="flex min-w-0 flex-col gap-8 lg:sticky lg:top-20 lg:col-span-5 lg:-mx-2 lg:max-h-[calc(100vh-6rem)] lg:self-start lg:overflow-y-auto lg:overflow-x-hidden lg:px-2"
          >
            <CommandGenerator client:idle referencedTargetCount={target.referencedTargets.length} target={commandTarget} />

            {includedInCollections.length > 0 && (
              <Panel headingId="collections-heading">
                <Fragment slot="title">Part of these collections</Fragment>
                <Fragment slot="subtitle">
                  {`${includedInCollections.length} ${includedInCollections.length === 1 ? "collection collects" : "collections collect"} this target`}
                </Fragment>
                <ul class="flex flex-wrap gap-2 p-3">
                  {includedInCollections.map((collection) => (
                    <li>
                      <a href={"/artifact/" + collection.slug} class={chipLinkClass}>
                        {collection.name}
                      </a>
                    </li>
                  ))}
                </ul>
              </Panel>
            )}

            {registryArtifacts.length > 0 && (
              <Panel headingId="registry-heading">
                <Fragment slot="title">Registry artifacts in these hives</Fragment>
                <Fragment slot="subtitle">
                  {`${registryArtifacts.length} artifacts in ${registryHives.join(", ")}`}
                </Fragment>
                <a href="/registry" slot="actions" class="panel-action focus-ring">
                  All registry artifacts
                </a>
                <ul class="flex flex-wrap gap-2 p-3">
                  {registryArtifacts.slice(0, MAX_REGISTRY_LINKS).map((artifact) => (
                    <li>
                      <a href={"/registry/" + artifact.slug} class={chipLinkClass}>
                        {artifact.name}
                      </a>
                    </li>
                  ))}
                </ul>
              </Panel>
            )}

            {eventLogEvents.length > 0 && (
              <Panel headingId="eventlogs-heading">
                <Fragment slot="title">Key event IDs in these logs</Fragment>
                <Fragment slot="subtitle">
                  {`${eventLogEvents.length} events with their fields and a sample`}
                </Fragment>
                <a href="/eventlogs" slot="actions" class="panel-action focus-ring">
                  All event logs
                </a>
                <ul class="flex flex-wrap gap-2 p-3">
                  {eventLogEvents.slice(0, MAX_EVENTLOG_LINKS).map((event) => (
                    <li>
                      <a href={`/eventlogs/${event.slug}`} class={chipLinkClass}>
                        <span class="mr-1.5 font-mono tabular-nums">{event.eventId}</span>
                        {event.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </Panel>
            )}

            <CyberChefLinks client:idle target={target} />

          </aside>
        </div>

        <ArtifactFooter className="mt-16 border-t border-border pt-4 text-xs text-muted-foreground">
          <span data-pagefind-ignore>Source: </span>
          <a
            data-pagefind-ignore
            href={"https://github.com/EricZimmerman/KapeFiles/blob/master/Targets/" +
                            target.category +
                            "/" +
                            target.sourceFile}
            target="_blank"
            rel="noopener noreferrer"
            class="focus-ring rounded-sm text-primary transition-colors hover:underline"
          >
            KapeFiles/{target.category}/{target.sourceFile}
            <span class="sr-only" data-pagefind-ignore>(opens in new tab)</span>
          </a>
        </ArtifactFooter>
      </ArtifactPageContainer>
    </div>
  </main>

  <Footer />
</Layout>
