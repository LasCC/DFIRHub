---
import { ConverterLayout } from "../components/converter/ConverterLayout";
import Footer from "../components/layout/Footer.astro";
import { Header } from "../components/layout/Header";
import Layout from "../layouts/Layout.astro";
import { buildBreadcrumbJsonLd, serializeJsonForScript, SITE_NAME, SITE_URL } from "../lib/seo";

const seoDescription =
  "Free Sigma rule converter. Convert Sigma detection rules to Splunk, Kusto, Lucene and other SIEM queries in your browser. Your rules never leave your device.";
const breadcrumbJsonLd = buildBreadcrumbJsonLd([
  { name: "Home", path: "/" },
  { name: "Sigma Converter", path: "/converter" },
]);
const applicationJsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  applicationCategory: "SecurityApplication",
  description: seoDescription,
  isAccessibleForFree: true,
  name: "Sigma Rule Converter",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  operatingSystem: "Web",
  provider: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
  url: `${SITE_URL}/converter`,
};
---

<Layout title="Sigma Rule Converter" description={seoDescription}>
  <script
    is:inline
    type="application/ld+json"
    set:html={serializeJsonForScript(breadcrumbJsonLd)}
    slot="head"
  />
  <script
    is:inline
    type="application/ld+json"
    set:html={serializeJsonForScript(applicationJsonLd)}
    slot="head"
  />
  <Header client:load currentPath={Astro.url.pathname} />

  <main id="main-content" class="flex-1 relative" tabindex="-1">
    <div class="mx-auto max-w-6xl px-4 py-6">
      <!-- Breadcrumb -->
      <nav class="mb-4 text-xs text-muted-foreground" aria-label="Breadcrumb">
        <ol class="flex items-center gap-1">
          <li>
            <a
              href="/"
              class="hover:text-foreground transition-colors focus-ring rounded-sm px-1"
              >Home</a
            >
          </li>
          <li class="flex items-center gap-1">
            <span aria-hidden="true">/</span>
            <span class="text-foreground px-1" aria-current="page">Converter</span>
          </li>
        </ol>
      </nav>

      <!-- Header -->
      <header class="mb-6 max-w-2xl">
        <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight mb-1.5">Sigma Rule Converter</h1>
        <p class="text-sm text-muted-foreground">
          Convert Sigma rules to SIEM queries without leaving your browser.
        </p>
      </header>

      <!-- Converter Component (client-only to avoid SSR issues with Monaco/Pyodide) -->
      <ConverterLayout client:only="react" />
    </div>
  </main>

  <Footer />

  <script is:inline>
    if ("serviceWorker" in navigator) {
      navigator.serviceWorker.register("/sw.js").catch(() => {
        // SW registration is best-effort; ignore failures
      });
    }
  </script>
</Layout>
